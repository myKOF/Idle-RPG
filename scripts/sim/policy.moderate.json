{
  "name": "policy-moderate",
  "description": "中度玩家：每日遊玩4小時。目標全身神話裝+35，詞條70%+首飾保證1鑲嵌/1經驗/1掉寶，金幣充裕升級商店，每20分鐘掃商店+重置2次，10分鐘寶石合成與高塔，主動技能融合。自動熔煉分解普通~稀有裝備確保背包暢通，機體強度提升後立刻重新勾選自動推關衝刺高關(stage.goMax)",
  "decideEveryGameSec": 30,
  "dailyActiveHours": 4,
  "needPanels": ["tower", "gems", "newforge", "equip", "skills", "header"],
  "lists": {
    "skillPriority": [
      "powerSlash", "doubleStrike", "sharpBlade", "toughness", "whirlwind",
      "swiftness", "armorBreak", "arcaneMind", "healWound", "ironWall",
      "executeStrike", "berserkStrike", "rendWound", "brutality", "vampirism"
    ],
    "targetAffixes": ["gemEff", "xpGain", "dropRate", "patk"]
  },
  "rules": [
    {
      "id": "auto-equip-on",
      "once": true,
      "cmd": "factory.setAutoEquip",
      "args": { "on": true },
      "why": "品質高優先穿：開啟自動換裝"
    },
    {
      "id": "auto-advance-init-on",
      "everySec": 15,
      "cmd": "stage.setAutoAdvance",
      "args": { "on": true },
      "why": "持續保持自動推關勾選狀態以極速推關"
    },
    {
      "id": "push-max-stage",
      "everySec": 15,
      "cmd": "stage.goMax",
      "why": "極速衝刺最高解鎖關卡"
    },

    {
      "id": "add-furnace-max",
      "everySec": 1800,
      "cmd": "newforge.addFurnace",
      "why": "熔爐開到當前可開的最大數量"
    },
    {
      "id": "salvage-low-rarities",
      "once": true,
      "cmd": "newforge.setQuality",
      "argsList": [
        { "furnaceId": 1, "rarity": 0, "on": true },
        { "furnaceId": 1, "rarity": 1, "on": true },
        { "furnaceId": 1, "rarity": 2, "on": true }
      ],
      "why": "自動分解普通、優良、稀有品質裝備，保持背包暢通"
    },

    {
      "id": "upgrade-weapon",
      "everySec": 60,
      "if": [["panels.equip.equipment.weapon", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.weapon.id" } },
      "why": "目標強化至+35：主手武器"
    },
    {
      "id": "upgrade-chest",
      "everySec": 60,
      "if": [["panels.equip.equipment.chest", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.chest.id" } },
      "why": "目標強化至+35：胸甲"
    },

    {
      "id": "reroll-jewel-amulet",
      "everySec": 300,
      "if": [["panels.equip.equipment.amulet", "truthy"]],
      "cmd": "item.rerollAffix",
      "expand": [{ "key": "affixKey", "list": "targetAffixes" }],
      "args": {
        "itemId": { "$path": "panels.equip.equipment.amulet.id" },
        "affixKey": { "$arg": "affixKey" }
      },
      "why": "詞條策略：項鍊保證1條寶石鑲嵌率、1條經驗加成、1條掉寶率詞條"
    },
    {
      "id": "reroll-jewel-ring",
      "everySec": 300,
      "if": [["panels.equip.equipment.ring", "truthy"]],
      "cmd": "item.rerollAffix",
      "expand": [{ "key": "affixKey", "list": "targetAffixes" }],
      "args": {
        "itemId": { "$path": "panels.equip.equipment.ring.id" },
        "affixKey": { "$arg": "affixKey" }
      },
      "why": "詞條策略：戒指保證1條寶石鑲嵌率、1條經驗加成、1條掉寶率詞條"
    },

    {
      "id": "learn-skills",
      "everySec": 30,
      "cmd": "skill.learn",
      "expand": [{ "key": "id", "list": "skillPriority" }],
      "why": "有技能點即升級技能"
    },
    {
      "id": "fuse-skills",
      "everySec": 1200,
      "cmd": "skill.fuse",
      "why": "主動使用技能融合以強化技能"
    },

    {
      "id": "gem-shop-buy-1",
      "everySec": 1200,
      "cmd": "gem.shopBuyAll",
      "why": "每20分鐘買光所有商店寶石"
    },
    {
      "id": "gem-shop-refresh-1",
      "everySec": 1200,
      "cmd": "gem.shopRefresh",
      "why": "重置寶石商店第1次"
    },
    {
      "id": "gem-shop-refresh-2",
      "everySec": 1200,
      "cmd": "gem.shopRefresh",
      "why": "重置寶石商店第2次"
    },
    {
      "id": "gem-shop-buy-2",
      "everySec": 1200,
      "cmd": "gem.shopBuyAll",
      "why": "重置後再次買光寶石商店"
    },
    {
      "id": "gem-shop-upgrade",
      "everySec": 1800,
      "cmd": "gem.shopUpgrade",
      "why": "剩餘金幣嘗試升級寶石商店"
    },
    {
      "id": "gem-compose",
      "everySec": 600,
      "cmd": "gem.composeAll",
      "expand": [
        { "key": "type", "path": "panels.gems.gems" },
        { "key": "level", "values": [1, 2, 3, 4, 5, 6, 7, 8, 9] }
      ],
      "why": "每10分鐘自動向上合成達10級寶石"
    },

    {
      "id": "tower-auto",
      "everySec": 600,
      "cmd": "tower.startAuto",
      "args": {
        "floor": { "$add": [{ "$path": "panels.tower.tower.highest" }, 1] },
        "count": 1
      },
      "why": "每20分鐘嘗試一次BOSS挑戰"
    },
    {
      "id": "tower-finish-if-needed",
      "everySec": 30,
      "if": [["panels.tower.tower.active", "truthy"]],
      "cmd": "tower.finish",
      "why": "高塔挑戰結束後回到一般場景戰鬥繼續遊玩"
    }
  ]
}
