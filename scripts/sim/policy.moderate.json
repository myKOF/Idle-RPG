  "rules": [
    {
      "id": "survival-gate",
      "everySec": 15,
      "cmd": "stage.setAutoAdvance",
      "stageGate": {
        "stage": "view.stage",
        "equippedRarities": "panels.inv.equipmentRarities",
        "argKey": "on",
        "checkpoints": [
          {
            "maxStage": 20,
            "minRarity": 2,
            "coverage": 0.85,
            "park": [
              11,
              15
            ],
            "依據": "指南1＋安全關卡1. 前20關在11~15關刷到全身稀有"
          },
          {
            "maxStage": 40,
            "minRarity": 3,
            "coverage": 0.85,
            "park": [
              21,
              25
            ],
            "依據": "指南2＋安全關卡2. 過20關菁英後在21~25關刷到全身獨特"
          },
          {
            "maxStage": 50,
            "minRarity": 4,
            "coverage": 0.3,
            "park": [
              41,
              45
            ],
            "依據": "指南4＋安全關卡3. 過40關菁英後在41~45關刷到一部份史詩"
          },
          {
            "maxStage": 59,
            "minRarity": 4,
            "coverage": 0.85,
            "park": [
              51,
              59
            ],
            "依據": "指南5＋安全關卡4. 過50關BOSS後在51~59關刷到全身史詩"
          },
          {
            "minRarity": 0,
            "coverage": 0,
            "依據": "指南只涵蓋前期，之後交回各強度自己的推關策略"
          }
        ],
        "retreatCmd": "stage.go"
      },
      "why": "依 player_strategy.md「前期優先生存任務指南」控制自動推關：裝備品質覆蓋率沒到門檻就關掉自動推關、留在原地掛機把裝備換上來。指南的核心是不要讓關卡跑在裝備前面——推太深只會一直死，死了就掉不到裝備，掉不到裝備就更推不動。先前是無條件每 15 秒送一次「開啟自動推關」，正是指南要防的那件事。覆蓋率只算身上真的有裝備的部位（空部位面板值為 -1，雙手武器會讓 weapon2 永遠空著，算進分母的話門檻永遠到不了、閘門永久關閉）"
    },
    {
      "id": "equip-best-per-slot",
      "everySec": 15,
      "cmd": "item.equip",
      "bestPerSlot": {
        "items": "panels.inv.items",
        "equippedScores": "panels.inv.equipmentScores",
        "equipment": "panels.inv.equipment"
      },
      "why": "換裝優先序：品質 >> 等級 >> 太古詞條數 >> 評分（player_strategy.md）。評分只當平手裁判——itemScore 把品質、等級、太古壓成一個數字，照它排會出現「品質低一階但詞條滾得好所以分數高」而換錯，而品質決定插槽數與附魔欄數，換不回來"
    },
    {
      "id": "upgrade-by-rarity-cap",
      "everySec": 60,
      "cmd": "item.upgrade",
      "why": "依品質分配強化資源：R0/R1 不強化，R2→+6，R3→+11，R4→+17，之後每階 +6；身上最高品質不設上限。低階裝要強到打得動下一段關卡（推不過去就掉不到好裝），但不能把材料砸在遲早換掉的裝備上——換掉時強化等級會一起消失",
      "upgradePriority": {
        "equippedRarities": "panels.inv.equipmentRarities",
        "equipment": "panels.inv.equipment",
        "capByRarity": [
          0,
          0,
          6,
          11,
          17,
          23,
          29,
          35,
          41,
          47,
          53
        ]
      }
    },
    {
      "id": "gem-convert",
      "everySec": 60,
      "cmd": "gem.convert",
      "convertToPreferred": {
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ],
            "依據": "前50級：爆擊率、爆擊傷害、生命、物理攻擊、魔法攻擊"
          },
          {
            "maxLevel": 100,
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "51~100級：暴擊率、爆擊傷害"
          },
          {
            "when": [
              "panels.header.stats.critRate",
              ">=",
              100
            ],
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ],
            "依據": "101以後且爆率100%以上：一半爆擊傷害、一半六大屬性傷害加成"
          },
          {
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "101以後但爆率未達100%：繼續補爆擊率與爆擊傷害"
          }
        ],
        "maxSlots": 9,
        "maxPerSlot": 1000,
        "maxCommands": 4,
        "quota": [
          {
            "type": "malachite",
            "count": 1,
            "依據": "物理抗性寶石至少鑲一個"
          },
          {
            "type": "fluorite",
            "count": 1,
            "依據": "魔法抗性寶石至少鑲一個"
          },
          {
            "type": "kyanite",
            "count": 2,
            "when": [
              "view.mp",
              "<",
              {
                "$mul": [
                  {
                    "$path": "view.mpMax"
                  },
                  0.3
                ]
              }
            ],
            "依據": "法力恢復不夠者補法力恢復寶石至夠用"
          }
        ]
      },
      "why": "把不在當前偏好段的寶石同階轉成偏好種類。偏好種類只佔 40 種寶石裡的 5~7 種、掉落又隨機，光靠「挑有貨的鑲」永遠補不滿（實測 3 小時偏好種類只有 5/20 顆）。轉換在遊戲裡同階 1:1、數量不變、不花金幣（convertGems），是既有庫存的重新分配。排在 gem-compose 之前：先把同種類集中起來，合成才有 3 顆可併，鑲上去的階級才會跟著上去。配額種類（抗性、法力恢復）不轉走；目標在偏好種類間輪流分配，否則 101 段的「一半爆傷、一半屬性」會被轉成清一色爆傷。maxSlots/maxPerSlot 對應遊戲的 GEM_CONVERT_SLOTS/GEM_CONVERT_STACK，超過會整批被回絕"
    },
    {
      "id": "gem-compose",
      "everySec": 60,
      "cmd": "gem.composeAll",
      "expand": [
        {
          "key": "type",
          "path": "panels.gems.gems",
          "nonEmpty": true
        },
        {
          "key": "level",
          "values": [
            1,
            2,
            3,
            4
          ]
        }
      ],
      "why": "鑲嵌前先把寶石向上合成至當前可合成的最高品質（一般合成上限為 5 級，GEM_MAX_LEVEL；6 級以上只能由熔爐產出，送 5~9 階必被回絕故不送）。nonEmpty 只送手上真的有貨的種類——遊戲開局就把 40 種寶石建好且數量為 0"
    },
    {
      "id": "unsocket-off-priority",
      "everySec": 60,
      "cmd": "gem.unsocket",
      "unsocketOffPriority": {
        "equipment": "panels.inv.equipment",
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ],
            "依據": "前50級：爆擊率、爆擊傷害、生命、物理攻擊、魔法攻擊"
          },
          {
            "maxLevel": 100,
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "51~100級：暴擊率、爆擊傷害"
          },
          {
            "when": [
              "panels.header.stats.critRate",
              ">=",
              100
            ],
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ],
            "依據": "101以後且爆率100%以上：一半爆擊傷害、一半六大屬性傷害加成"
          },
          {
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "101以後但爆率未達100%：繼續補爆擊率與爆擊傷害"
          }
        ],
        "maxPerDecision": 2,
        "replaceWith": "gem.socket",
        "minLevelByType": {
          "topaz": 3,
          "ruby": 3,
          "sapphire": 3
        },
        "quota": [
          {
            "type": "malachite",
            "count": 1,
            "依據": "物理抗性寶石至少鑲一個"
          },
          {
            "type": "fluorite",
            "count": 1,
            "依據": "魔法抗性寶石至少鑲一個"
          },
          {
            "type": "kyanite",
            "count": 2,
            "when": [
              "view.mp",
              "<",
              {
                "$mul": [
                  {
                    "$path": "view.mpMax"
                  },
                  0.3
                ]
              }
            ],
            "依據": "法力恢復不夠者補法力恢復寶石至夠用"
          }
        ]
      },
      "why": "把不符當前偏好段、或階級低於庫存最高階的寶石換掉（拆與補在同一決策點成對送出）。socketEmpty 只填空槽，前期偏好種類還沒掉到時鑲上的雜牌會把插槽佔死（實測 3 小時後 12 個插槽偏好種類 0 顆），等級跨段時也不會有任何變化。只拆不補的話空槽會被 socket-gems 的退路重新塞回雜牌，變成每分鐘拆了又鑲。拆寶石在遊戲裡免費無損（unsocketGem 直接退回庫存），故為純重新配置；補不到偏好種類就完全不動，每次最多換 2 顆"
    },
    {
      "id": "socket-gems",
      "everySec": 60,
      "cmd": "gem.socket",
      "socketEmpty": {
        "equipment": "panels.inv.equipment",
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ],
            "依據": "前50級：爆擊率、爆擊傷害、生命、物理攻擊、魔法攻擊"
          },
          {
            "maxLevel": 100,
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "51~100級：暴擊率、爆擊傷害"
          },
          {
            "when": [
              "panels.header.stats.critRate",
              ">=",
              100
            ],
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ],
            "依據": "101以後且爆率100%以上：一半爆擊傷害、一半六大屬性傷害加成"
          },
          {
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "101以後但爆率未達100%：繼續補爆擊率與爆擊傷害"
          }
        ],
        "minLevelByType": {
          "topaz": 3,
          "ruby": 3,
          "sapphire": 3
        },
        "quota": [
          {
            "type": "malachite",
            "count": 1,
            "依據": "物理抗性寶石至少鑲一個"
          },
          {
            "type": "fluorite",
            "count": 1,
            "依據": "魔法抗性寶石至少鑲一個"
          },
          {
            "type": "kyanite",
            "count": 2,
            "when": [
              "view.mp",
              "<",
              {
                "$mul": [
                  {
                    "$path": "view.mpMax"
                  },
                  0.3
                ]
              }
            ],
            "依據": "法力恢復不夠者補法力恢復寶石至夠用"
          }
        ]
      },
      "why": "把寶石鑲進空插槽，依 player_strategy.md 寶石鑲嵌策略分段：前50級 生命→暴擊率→吸血→物攻→魔攻；51~100 吸血→暴擊率→爆傷→生命→物攻→魔攻；101以後 一半爆傷、一半六大屬性傷害加成（mix 兩組輪流）。手上沒有偏好種類就鑲任何有貨的；階級由遊戲挑（socketGem 取庫存最高階），所以本規則排在 gem-compose 之後，先合成再鑲就會鑲到當前可得的最高品質"
    },
    {
      "id": "reroll-off-target",
      "everySec": 300,
      "cmd": "item.rerollAffix",
      "rerollOffTarget": {
        "equipment": "panels.inv.equipment",
        "minRarity": 3,
        "keepAncient": true,
        "targetGroups": [
          {
            "slots": [
              "weapon",
              "weapon2"
            ],
            "lists": [
              {
                "list": "affixWeapon"
              },
              {
                "list": "affixCritDmg",
                "when": [
                  "panels.header.stats.critRate",
                  ">",
                  50
                ]
              }
            ],
            "依據": "主副手：全洗傷害類，百分比>定值；爆傷只在爆率高於50%後才洗"
          },
          {
            "slots": [
              "ring",
              "ring2",
              "amulet"
            ],
            "lists": [
              {
                "list": "affixJewel"
              },
              {
                "list": "affixCritDmg",
                "when": [
                  "panels.header.stats.critRate",
                  ">",
                  50
                ]
              }
            ],
            "依據": "項鏈戒指：寶石鑲嵌效率最關鍵，其次掉寶率與經驗加成"
          },
          {
            "lists": [
              {
                "list": "affixArmor"
              }
            ],
            "依據": "防具：以防禦性詞條為主，保留一條物攻；不留單一元素抗性（怪物屬性隨機），改留全抗性與全局減傷"
          }
        ]
      },
      "why": "依 player_strategy.md 裝備詞條洗煉策略分三組：主副手全傷害、防具以防禦為主、項鏈戒指以寶石鑲嵌效率/掉寶率/經驗加成為關鍵。用同一份清單套 13 個部位不可能對——武器洗不出防禦詞條，而 gemEff/loot/xpBonus 只有戒指項鏈出得來。爆傷要爆率破 50% 才留；閃避 300 級前不留；單一元素抗性不留（怪物屬性隨機，改留全抗性）",
      "if": [
        [
          "view.essence",
          ">=",
          20
        ]
      ]
    },
    {
      "id": "enchant-equipped",
      "everySec": 300,
      "cmd": "item.enchant",
      "enchantPriority": {
        "equipment": "panels.inv.equipment",
        "enchantInfo": "panels.inv.equipmentEnchantInfo",
        "books": "panels.inv.books",
        "byCategory": {
          "util": [
            "vigor"
          ],
          "atk": [
            "ice"
          ],
          "def": [
            "fireRes",
            "iceRes",
            "lightningRes",
            "poisonRes",
            "lightRes",
            "darkRes"
          ]
        },
        "spread": [
          "def"
        ],
        "maxPerDecision": 4
      },
      "why": "依 player_strategy.md 附魔策略：生命值(vigor)→冰凍(ice)→六大屬性抗性平均。遊戲規定每個部位只吃一種類別（enchantCatForType：武器/戒指/手套/護腕＝攻擊，項鍊/鞋子＝功能，其餘＝防禦），所以這份優先序實際上是按類別分工而不是單一排序：功能部位放生命值、攻擊部位放冰凍、防禦部位放六大抗性並輪流分散。部位與類別的對應取自遊戲的面板欄位，策略不自己抄——抄一份遲早跟遊戲脫鉤，而 manualEnchant 只會回「XX 只能使用 OO 類附魔」，看報表不會發現規則從沒生效"
    },
    {
      "id": "auto-equip-on",
      "once": true,
      "cmd": "factory.setAutoEquip",
      "args": {
        "on": true
      },
      "why": "品質高優先穿：開啟自動換裝"
    },
    {
      "id": "buy-inv-upgrade",
      "everySec": 600,
      "if": [
        [
          "panels.inv.cap",
          "<",
          1000
        ],
        [
          "panels.inv.expandCost",
          "<=",
          {
            "$path": "view.gold"
          }
        ]
      ],
      "cmd": "player.buyInvUpgrade",
      "why": "背包策略：逐步解鎖至1000格。先比對擴充成本與金幣才送出——沒有這個條件時實測 101 小時送了 1,212 次、其中 1,014 次是金幣不足的空轉"
    },
    {
      "id": "add-furnace-max",
      "everySec": 1800,
      "cmd": "newforge.addFurnace",
      "why": "熔爐解鎖到當前可開的最大數量"
    },
    {
      "id": "salvage-below-equipped",
      "everySec": 600,
      "cmd": "newforge.setQuality",
      "salvageBelowEquipped": {
        "equippedRarities": "panels.inv.equipmentRarities",
        "furnaces": "panels.newforge.newForge.furnaces"
      },
      "why": "最佳分解策略：分解門檻跟著身上最低品質往上升，低於它的裝備不可能升級任何部位。先前是 once:true 開局設一次「只拆R0/R1」就再也不動——101小時實測背包 298 格有 247 件稀有(83%)，背包一滿掉落連熔爐佇列都進不去而被直接丟棄，主手武器 90 小時等不到升級"
    },
    {
      "id": "salvage-when-bag-full",
      "everySec": 120,
      "cmd": "item.salvageBulk",
      "salvageWhenFull": {
        "count": "panels.inv.count",
        "cap": "panels.inv.cap",
        "equippedRarities": "panels.inv.equipmentRarities",
        "fullRatio": 0.9,
        "belowMaxBy": 1
      },
      "why": "背包壓力閥：使用率達 90% 時，把低於身上最高品質的庫存一次清掉。背包滿了不只是挑不到東西，而是整條掉落管線停擺——熔爐佇列推不進背包就回堵，新裝備直接丟棄，角色會停在原地打幾十小時而畫面完全正常"
    },
    {
      "id": "learn-skills",
      "everySec": 30,
      "cmd": "skill.learn",
      "expand": [
        {
          "key": "id",
          "listByLevel": [
            {
              "maxLevel": 50,
              "list": "skillEarly"
            },
            {
              "maxLevel": 100,
              "list": "skillMid"
            },
            {
              "list": "skillLate"
            }
          ]
        }
      ],
      "why": "依 player_strategy.md 技能升級優先順序分段：前期(≤50)先點生命上限被動與護盾／持續恢復；中期(51~100)把被動技能全點滿；後期(101+)依裝備詞條方向（targetAffixes 為物理向）集中投物理。清單順序即投點優先序，點數不足時後面的由遊戲擋下"
    },
    {
      "id": "fuse-skills",
      "everySec": 1200,
      "cmd": "skill.fuse",
      "why": "主動使用技能融合以強化技能"
    },
    {
