      "keenEye",
      "brutality",
      "swiftness",
      "vampirism",
      "toughness",
      "powerSlash",
      "doubleStrike",
      "whirlwind",
      "armorBreak",
      "executeStrike",
      "rendWound",
      "stunBlow",
      "berserkStrike",
      "preciseThrust",
      "heavySmash",
      "swiftCuts",
      "counterStance",
      "soulBrandFlurry",
      "sinDetonate",
      "echoBlade",
      "warSpiritEngine",
      "pursuitDecree",
      "warOverture",
      "woundCollapse",
      "mindflowChain",
      "swordDomain",
      "phantomEcho",
      "reaperTempo",
      "battleReflex",
      "zeroCadence",
      "afterimagePursuit",
      "huntSigil",
      "manaBarrier",
      "regenerate",
      "healWound",
