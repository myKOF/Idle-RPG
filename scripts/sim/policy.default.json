{
  "name": "baseline-idle-v2",
  "notes": [
    "預設基礎策略：換裝→強化→技能→熔煉→高塔。",
    "⚠️ 拆解只設普通/優良。遊戲的自動裝備只填空格、不做替換（js/player.js:313），",
    "所以稀有以上必須留在背包當換裝候選；全部拆掉的話角色會被鎖死在開場隨便填進去的裝備。",
    "⚠️ 不要加 stage.goMax 的高頻規則：死亡會退回第 1 關，goMax 會立刻把角色送回死掉的那一關，",
    "實測死亡次數從 100 次翻倍到 235 次。"
  ],
  "decideEveryGameSec": 15,
  "needPanels": [
    "tower",
    "gems",
    "forge",
    "newforge",
    "talents",
    "equip",
    "skills",
    "header",
    "inv"
  ],
  "lists": {
    "skillPriority": [
      "powerSlash",
      "doubleStrike",
      "sharpBlade",
      "toughness",
      "whirlwind",
      "swiftness",
      "armorBreak",
      "arcaneMind",
      "healWound",
      "ironWall"
    ],
    "targetAffixes": [
      "gemEff",
      "xpGain",
      "dropRate",
      "patk"
    ]
  },
  "rules": [
    {
      "id": "equip-best-per-slot",
      "everySec": 15,
      "cmd": "item.equip",
      "bestPerSlot": {
        "items": "panels.inv.items",
        "equippedScores": "panels.inv.equipmentScores"
      },
      "why": "每個部位換上背包裡評分最高且優於身上那件的裝備。評分是遊戲的 itemScore，策略只挑最大值。遊戲的自動裝備只填空格不做替換（js/player.js:313），不補這條就會穿著開場的普通裝打到底"
    },
    {
      "id": "auto-equip-on",
      "once": true,
      "cmd": "factory.setAutoEquip",
      "args": {
        "on": true
      },
      "why": "開啟自動換裝"
    },
    {
      "id": "auto-advance-on",
      "everySec": 15,
      "cmd": "stage.setAutoAdvance",
      "args": {
        "on": true
      },
      "why": "持續開啟自動推關"
    },
    {
      "id": "salvage-low-rarity",
      "once": true,
      "cmd": "newforge.setQuality",
      "argsList": [
        {
          "furnaceId": 1,
          "rarity": 0,
          "on": true
        },
        {
          "furnaceId": 1,
          "rarity": 1,
          "on": true
        }
      ],
      "why": "只拆解普通與優良。稀有以上要留在背包當換裝候選——遊戲的自動裝備只填空格不做替換（js/player.js:313），全拆掉等於把換裝的來源砍光，角色會被鎖死在開場隨便填進去的裝備"
    },
    {
      "id": "upgrade-weapon",
      "everySec": 30,
      "if": [
        [
          "panels.equip.equipment.weapon",
          "truthy"
        ]
      ],
      "cmd": "item.upgrade",
      "args": {
        "itemId": {
          "$path": "panels.equip.equipment.weapon.id"
        }
      },
      "why": "強化主手武器"
    },
    {
      "id": "upgrade-chest",
      "everySec": 30,
      "if": [
        [
          "panels.equip.equipment.chest",
          "truthy"
        ]
      ],
      "cmd": "item.upgrade",
      "args": {
        "itemId": {
          "$path": "panels.equip.equipment.chest.id"
        }
      },
      "why": "強化胸甲"
    },
    {
      "id": "learn-skills",
      "everySec": 30,
      "cmd": "skill.learn",
      "expand": [
        {
          "key": "id",
          "list": "skillPriority"
        }
      ],
      "why": "學習主動與被動技能"
    },
    {
      "id": "gem-shop-buy",
      "everySec": 600,
      "cmd": "gem.shopBuyAll",
      "why": "寶石商店有貨就買"
    },
    {
      "id": "gem-compose",
      "everySec": 600,
      "cmd": "gem.composeAll",
      "expand": [
        {
          "key": "type",
          "path": "panels.gems.gems"
        },
        {
          "key": "level",
          "values": [
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            9
          ]
        }
      ],
      "why": "低階寶石往上合成"
    },
    {
      "id": "tower-auto",
      "everySec": 600,
      "cmd": "tower.startAuto",
      "args": {
        "floor": {
          "$add": [
            {
              "$path": "panels.tower.tower.highest"
            },
            1
          ]
        },
        "count": 1
      },
      "why": "挑戰高塔"
    },
    {
      "id": "tower-finish-if-needed",
      "everySec": 30,
      "if": [
        [
          "panels.tower.tower.active",
          "truthy"
        ]
      ],
      "cmd": "tower.finish",
      "why": "高塔挑戰結束後回到野外戰鬥"
    }
  ]
}
