{
  "name": "baseline-idle-v2",
  "notes": [
    "預設基礎策略：包含自動推關、高塔挑戰與自動退場、自動換裝、熔煉與強化裝備"
  ],
  "decideEveryGameSec": 15,
  "needPanels": ["tower", "gems", "forge", "newforge", "talents", "equip", "skills", "header"],
  "lists": {
    "skillPriority": [
      "powerSlash", "doubleStrike", "sharpBlade", "toughness", "whirlwind",
      "swiftness", "armorBreak", "arcaneMind", "healWound", "ironWall"
    ],
    "targetAffixes": ["gemEff", "xpGain", "dropRate", "patk"]
  },
  "rules": [
    {
      "id": "auto-equip-on",
      "once": true,
      "cmd": "factory.setAutoEquip",
      "args": { "on": true },
      "why": "開啟自動換裝"
    },
    {
      "id": "auto-advance-on",
      "everySec": 15,
      "cmd": "stage.setAutoAdvance",
      "args": { "on": true },
      "why": "持續開啟自動推關"
    },
    {
      "id": "push-max-stage",
      "everySec": 15,
      "cmd": "stage.goMax",
      "why": "高頻衝刺最高解鎖關卡"
    },

    {
      "id": "salvage-low-rarity",
      "once": true,
      "cmd": "newforge.setQuality",
      "argsList": [
        { "furnaceId": 1, "rarity": 0, "on": true },
        { "furnaceId": 1, "rarity": 1, "on": true },
        { "furnaceId": 1, "rarity": 2, "on": true },
        { "furnaceId": 1, "rarity": 3, "on": true }
      ],
      "why": "自動分解普通~史詩裝備，保持背包暢通"
    },

    {
      "id": "upgrade-weapon",
      "everySec": 30,
      "if": [["panels.equip.equipment.weapon", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.weapon.id" } },
      "why": "強化主手武器"
    },
    {
      "id": "upgrade-chest",
      "everySec": 30,
      "if": [["panels.equip.equipment.chest", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.chest.id" } },
      "why": "強化胸甲"
    },

    {
      "id": "learn-skills",
      "everySec": 30,
      "cmd": "skill.learn",
      "expand": [{ "key": "id", "list": "skillPriority" }],
      "why": "學習主動與被動技能"
    },

    {
      "id": "gem-shop-buy",
      "everySec": 600,
      "cmd": "gem.shopBuyAll",
      "why": "寶石商店有貨就買"
    },
    {
      "id": "gem-compose",
      "everySec": 600,
      "cmd": "gem.composeAll",
      "expand": [
        { "key": "type", "path": "panels.gems.gems" },
        { "key": "level", "values": [1, 2, 3, 4, 5, 6, 7, 8, 9] }
      ],
      "why": "低階寶石往上合成"
    },

    {
      "id": "tower-auto",
      "everySec": 600,
      "cmd": "tower.startAuto",
      "args": {
        "floor": { "$add": [{ "$path": "panels.tower.tower.highest" }, 1] },
        "count": 1
      },
      "why": "挑戰高塔"
    },
    {
      "id": "tower-finish-if-needed",
      "everySec": 30,
      "if": [["panels.tower.tower.active", "truthy"]],
      "cmd": "tower.finish",
      "why": "高塔挑戰結束後回到野外戰鬥"
    }
  ]
}
