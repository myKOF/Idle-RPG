{
  "name": "lategame-systems-v1",
  "notes": [
    "用途：測到天賦、神鑄熔爐、高塔這三個系統。",
    "⚠️ 本策略使用 GM 指令建立測試前提（下方 bootstrap），這是「墊出來的狀態」",
    "⚠️ 拆解只設普通/優良 (R0~R1)，保留稀有及以上裝備供 equip-best-per-slot 換裝。"
  ],
  "bootstrap": [
    "level 1000",
    "reincarnation 3",
    "stage 100"
  ],
  "decideEveryGameSec": 30,
  "needPanels": [
    "tower",
    "gems",
    "forge",
    "newforge",
    "talents",
    "equip",
    "skills",
    "inv"
  ],
  "lists": {
    "talentPriority": [
      "t1_str",
      "t1_agi",
      "t1_int",
      "t1_vit",
      "t1_def",
      "t1_mdef",
      "t1_pres",
      "t1_mres",
      "t2_crit",
      "t2_critdmg",
      "t2_hit",
      "t2_hp",
      "t2_shield",
      "t2_evasion",
      "t2_normalred",
      "t2_elitered",
      "t3_normal",
      "t3_elite",
      "t3_boss",
      "t3_potential",
      "t3_allres",
      "t3_def",
      "t3_mdef",
      "t3_allres2",
      "t4_phys",
      "t4_magic",
      "t4_def",
      "t4_special",
      "t4_passive",
      "t4_potential",
      "t4_normalred",
      "t4_elitered"
    ],
    "skillEarly": [
      "toughness",
      "manaBarrier",
      "regenerate",
      "healWound",
      "secondWind",
      "vampirism",
      "sharpBlade",
      "powerSlash",
      "doubleStrike",
      "whirlwind",
      "armorBreak"
    ],
    "skillMid": [
      "toughness",
      "sharpBlade",
      "keenEye",
      "brutality",
      "vampirism",
      "swiftness",
      "ironSkin",
      "fortuneFavor",
      "phantomEcho",
      "meditation",
      "reaperTempo",
      "battleReflex",
      "zeroCadence",
      "afterimagePursuit",
      "bulwarkFeedback",
      "huntSigil",
      "lingeringGlow",
      "virulentPulse",
      "arcaneMind",
      "manaBarrier",
      "regenerate",
      "healWound",
      "secondWind"
    ],
    "skillLate": [
      "sharpBlade",
      "keenEye",
      "brutality",
      "swiftness",
      "vampirism",
      "toughness",
      "powerSlash",
      "doubleStrike",
      "whirlwind",
      "armorBreak",
      "executeStrike",
      "rendWound",
      "stunBlow",
      "berserkStrike",
      "preciseThrust",
      "heavySmash",
      "swiftCuts",
      "counterStance",
      "soulBrandFlurry",
      "sinDetonate",
      "echoBlade",
      "warSpiritEngine",
      "pursuitDecree",
      "warOverture",
      "woundCollapse",
      "mindflowChain",
      "swordDomain",
      "phantomEcho",
      "reaperTempo",
      "battleReflex",
      "zeroCadence",
      "afterimagePursuit",
      "huntSigil",
      "manaBarrier",
      "regenerate",
      "healWound",
      "secondWind"
    ]
  },
  "rules": [
    {
      "id": "equip-best-per-slot",
      "everySec": 15,
      "cmd": "item.equip",
      "bestPerSlot": {
        "items": "panels.inv.items",
        "equippedScores": "panels.inv.equipmentScores"
      },
      "why": "每個部位換上背包裡評分最高且優於身上那件的裝備"
    },
    {
      "id": "auto-equip-on",
      "once": true,
      "cmd": "factory.setAutoEquip",
      "args": {
        "on": true
      }
    },
    {
      "id": "auto-advance-on",
      "once": true,
      "cmd": "stage.setAutoAdvance",
      "args": {
        "on": true
      }
    },
    {
      "id": "salvage-low-rarity",
      "once": true,
      "cmd": "newforge.setQuality",
      "argsList": [
        {
          "furnaceId": 1,
          "rarity": 0,
          "on": true
        },
        {
          "furnaceId": 1,
          "rarity": 1,
          "on": true
        }
      ],
      "why": "只拆解普通與優良 (R0~R1)"
    },
    {
      "id": "learn-skills",
      "everySec": 120,
      "cmd": "skill.learn",
      "expand": [
        {
          "key": "id",
          "listByLevel": [
            {
              "maxLevel": 50,
              "list": "skillEarly"
            },
            {
              "maxLevel": 100,
              "list": "skillMid"
            },
            {
              "list": "skillLate"
            }
          ]
        }
      ],
      "why": "依 player_strategy.md 技能升級優先順序分段：前期(≤50)先點生命上限被動與護盾／持續恢復；中期(51~100)把被動技能全點滿；後期(101+)依裝備詞條方向（targetAffixes 為物理向）集中投物理。清單順序即投點優先序，點數不足時後面的由遊戲擋下"
    },
    {
      "id": "buy-inventory",
      "everySec": 600,
      "cmd": "player.buyInvUpgrade"
    },
    {
      "id": "talent-upgrade",
      "everySec": 120,
      "cmd": "talent.upgrade",
      "expand": [
        {
          "key": "id",
          "list": "talentPriority"
        }
      ],
      "if": [
        [
          "panels.talents.talentPoints",
          ">",
          0
        ]
      ],
      "why": "依固定優先序配天賦點"
    },
    {
      "id": "gem-shop-buy",
      "everySec": 600,
      "cmd": "gem.shopBuyAll"
    },
    {
      "id": "forge-auto-on",
      "everySec": 600,
      "cmd": "forge.setAuto",
      "args": {
        "key": "autoForge",
        "on": true
      },
      "if": [
        [
          "panels.forge.forge.unlocked",
          "truthy"
        ]
      ]
    },
    {
      "id": "forge-autofill",
      "everySec": 1800,
      "cmd": "forge.setAutoFill",
      "args": {
        "kind": "equip",
        "rarity": 4
      },
      "if": [
        [
          "panels.forge.forge.unlocked",
          "truthy"
        ]
      ]
    },
    {
      "id": "newforge-add-furnace",
      "everySec": 1800,
      "cmd": "newforge.addFurnace"
    },
    {
      "id": "tower-auto",
      "everySec": 300,
      "cmd": "tower.startAuto",
      "args": {
        "floor": {
          "$add": [
            {
              "$path": "panels.tower.tower.highest"
            },
            1
          ]
        },
        "count": 10
      }
    },
    {
      "id": "tower-finish-if-needed",
      "everySec": 30,
      "if": [
        [
          "panels.tower.tower.active",
          "truthy"
        ]
      ],
      "cmd": "tower.finish"
    },
    {
      "id": "gem-compose",
      "everySec": 60,
      "cmd": "gem.composeAll",
      "expand": [
        {
          "key": "type",
          "path": "panels.gems.gems",
          "nonEmpty": true
        },
        {
          "key": "level",
          "values": [
            1,
            2,
            3,
            4
          ]
        }
      ],
      "why": "鑲嵌前先把寶石向上合成至當前可合成的最高品質（一般合成上限為 5 級，GEM_MAX_LEVEL；6 級以上只能由熔爐產出，送 5~9 階必被回絕故不送）。nonEmpty 只送手上真的有貨的種類——遊戲開局就把 40 種寶石建好且數量為 0"
    },
    {
      "id": "unsocket-off-priority",
      "everySec": 60,
      "cmd": "gem.unsocket",
      "unsocketOffPriority": {
        "equipment": "panels.inv.equipment",
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "topaz",
              "amethyst",
              "onyx",
              "ruby",
              "sapphire"
            ]
          },
          {
            "maxLevel": 100,
            "types": [
              "onyx",
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ]
          },
          {
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ]
          }
        ],
        "maxPerDecision": 2,
        "replaceWith": "gem.socket"
      },
      "why": "把不符當前偏好段、或階級低於庫存最高階的寶石換掉（拆與補在同一決策點成對送出）。socketEmpty 只填空槽，前期偏好種類還沒掉到時鑲上的雜牌會把插槽佔死（實測 3 小時後 12 個插槽偏好種類 0 顆），等級跨段時也不會有任何變化。只拆不補的話空槽會被 socket-gems 的退路重新塞回雜牌，變成每分鐘拆了又鑲。拆寶石在遊戲裡免費無損（unsocketGem 直接退回庫存），故為純重新配置；補不到偏好種類就完全不動，每次最多換 2 顆"
    },
    {
      "id": "socket-gems",
      "everySec": 60,
      "cmd": "gem.socket",
      "socketEmpty": {
        "equipment": "panels.inv.equipment",
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "topaz",
              "amethyst",
              "onyx",
              "ruby",
              "sapphire"
            ]
          },
          {
            "maxLevel": 100,
            "types": [
              "onyx",
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ]
          },
          {
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ]
          }
        ]
      },
      "why": "把寶石鑲進空插槽，依 player_strategy.md 寶石鑲嵌策略分段：前50級 生命→暴擊率→吸血→物攻→魔攻；51~100 吸血→暴擊率→爆傷→生命→物攻→魔攻；101以後 一半爆傷、一半六大屬性傷害加成（mix 兩組輪流）。手上沒有偏好種類就鑲任何有貨的；階級由遊戲挑（socketGem 取庫存最高階），所以本規則排在 gem-compose 之後，先合成再鑲就會鑲到當前可得的最高品質"
    }
  ]
}
