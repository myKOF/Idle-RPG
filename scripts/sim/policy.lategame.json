{
  "name": "lategame-systems-v1",
  "notes": [
    "用途：測到天賦、神鑄熔爐、高塔這三個系統。",
    "⚠️ 本策略使用 GM 指令建立測試前提（下方 bootstrap），這是「墊出來的狀態」",
    "⚠️ 拆解只設普通/優良 (R0~R1)，保留稀有及以上裝備供 equip-best-per-slot 換裝。"
  ],
  "bootstrap": [
    "level 1000",
    "reincarnation 3",
    "stage 100"
  ],
  "decideEveryGameSec": 30,
  "needPanels": [
    "tower",
    "gems",
    "forge",
    "newforge",
    "talents",
    "equip",
    "inv",
    "header",
    "battle",
    "rune",
    "skill",
    "taskGoal",
    "equipRules"
  ],
  "lists": {
    "talentPriority": [
      "t1_str",
      "t1_agi",
      "t1_int",
      "t1_vit",
      "t1_def",
      "t1_mdef",
      "t1_pres",
      "t1_mres",
      "t2_crit",
      "t2_critdmg",
      "t2_hit",
      "t2_hp",
      "t2_shield",
      "t2_evasion",
      "t2_normalred",
      "t2_elitered",
      "t3_normal",
      "t3_elite",
      "t3_boss",
      "t3_potential",
      "t3_allres",
      "t3_def",
      "t3_mdef",
      "t3_allres2",
      "t4_phys",
      "t4_magic",
      "t4_def",
      "t4_special",
      "t4_passive",
      "t4_potential",
      "t4_normalred",
      "t4_elitered"
    ],
    "affixWeapon": [
      "atkPct",
      "critRate",
      "aspd",
      "pPen",
      "eliteDmg",
      "bossDmg",
      "aoeDmg",
      "atkFlat"
    ],
    "affixArmor": [
      "hpPct",
      "hpFlat",
      "defPct",
      "mdefPct",
      "globalDmgRed",
      "resAll",
      "pRes",
      "mRes",
      "shieldEff",
      "blockRate",
      "blockDmgRed",
      "tenacity",
      "eliteDmgRed",
      "bossDmgRed",
      "hit",
      "lifesteal",
      "atkFlat",
      "defFlat",
      "mdefFlat"
    ],
    "affixJewel": [
      "gemEff",
      "loot",
      "xpBonus",
      "atkPct",
      "critRate",
      "pPen",
      "aspd",
      "eliteDmg",
      "bossDmg",
      "hit",
      "hpPct",
      "globalDmgRed",
      "resAll",
      "eliteDmgRed",
      "bossDmgRed",
      "shieldEff",
      "lifesteal",
      "atkFlat"
    ],
    "affixCritDmg": [
