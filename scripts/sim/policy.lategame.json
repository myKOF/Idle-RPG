              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ],
            "依據": "前50級：爆擊率、爆擊傷害、生命、物理攻擊、魔法攻擊"
          },
          {
            "maxLevel": 100,
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "51~100級：暴擊率、爆擊傷害"
          },
          {
            "maxLevel": 200,
            "when": [
              "panels.header.stats.critRate",
