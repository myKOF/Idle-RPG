              ">=",
              100
            ],
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ],
            "依據": "201以後：爆傷邊際效益出現，一半換成元素屬性傷害加成寶石"
          },
          {
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "收尾段：爆率未達100%時繼續補爆擊"
          }
        ],
        "maxPerDecision": 2,
        "replaceWith": "gem.socket",
        "minLevelByType": {
          "topaz": 3,
          "ruby": 3,
          "sapphire": 3,
          "coreFire": 6,
          "coreIce": 6,
          "coreLightning": 6,
          "corePoison": 6,
          "coreLight": 6,
          "coreDark": 6
        },
        "quota": [
          {
            "type": "malachite",
            "count": 1,
            "依據": "物理/魔法抗性寶石依情況替換（打菁英或BOSS時）",
            "when": [
              "ctx.mode",
              "!=",
              "normal"
            ]
          },
          {
            "type": "fluorite",
            "count": 1,
            "依據": "物理/魔法抗性寶石依情況替換（打菁英或BOSS時）",
            "when": [
              "ctx.mode",
              "!=",
              "normal"
            ]
          },
          {
            "type": "kyanite",
            "count": 2,
            "when": [
              "view.mp",
              "<",
              {
                "$mul": [
                  {
                    "$path": "view.mpMax"
                  },
                  0.3
                ]
              }
            ],
            "依據": "法力恢復不夠者補法力恢復寶石至夠用"
          }
        ]
      },
      "why": "把不符當前偏好段、或階級低於庫存最高階的寶石換掉（拆與補在同一決策點成對送出）。socketEmpty 只填空槽，前期偏好種類還沒掉到時鑲上的雜牌會把插槽佔死（實測 3 小時後 12 個插槽偏好種類 0 顆），等級跨段時也不會有任何變化。只拆不補的話空槽會被 socket-gems 的退路重新塞回雜牌，變成每分鐘拆了又鑲。拆寶石在遊戲裡免費無損（unsocketGem 直接退回庫存），故為純重新配置；補不到偏好種類就完全不動，每次最多換 2 顆"
    },
