  "rules": [
    {
      "id": "survival-gate",
      "everySec": 15,
      "cmd": "stage.setAutoAdvance",
      "stageGate": {
        "stage": "view.stage",
        "equippedRarities": "panels.inv.equipmentRarities",
        "argKey": "on",
        "checkpoints": [
          {
            "maxStage": 20,
            "minRarity": 2,
            "coverage": 0.85,
            "park": [
              11,
              15
            ],
            "依據": "指南1＋安全關卡1. 前20關在11~15關刷到全身稀有"
          },
          {
            "maxStage": 40,
            "minRarity": 3,
            "coverage": 0.85,
            "park": [
              21,
              25
            ],
            "依據": "指南2＋安全關卡2. 過20關菁英後在21~25關刷到全身獨特"
          },
          {
            "maxStage": 50,
            "minRarity": 4,
            "coverage": 0.3,
            "park": [
              41,
              45
            ],
            "依據": "指南4＋安全關卡3. 過40關菁英後在41~45關刷到一部份史詩"
          },
          {
            "maxStage": 59,
            "minRarity": 4,
            "coverage": 0.85,
            "park": [
              51,
              59
            ],
            "依據": "指南5＋安全關卡4. 過50關BOSS後在51~59關刷到全身史詩"
          },
          {
            "minRarity": 0,
            "coverage": 0,
            "依據": "指南只涵蓋前期，之後交回各強度自己的推關策略"
          }
        ],
        "retreatCmd": "stage.go",
        "requireTargets": [
          "killRate"
        ],
        "targetRetreat": {
          "step": 5,
          "everySec": 300,
          "minStage": 1,
          "說明": "產出不足就每 300 秒往回退 5 關。everySec 必須 >= killRate 的 windowSec（tests/policy-keys.test.cjs 有哨兵）"
        },
        "requireTargets_依據": "極限玩家 dailyActiveHours=24 全程在線，沒有離線收益可領，所以「待在刷得動的關卡」直接決定產出。實測 4 個 seed：中位等級 201→412、擊殺 30K→138K、死亡 73→23"
      },
      "why": "依 player_strategy.md「前期優先生存任務指南」控制自動推關：裝備品質覆蓋率沒到門檻就關掉自動推關、留在原地掛機把裝備換上來。指南的核心是不要讓關卡跑在裝備前面——推太深只會一直死，死了就掉不到裝備，掉不到裝備就更推不動。先前是無條件每 15 秒送一次「開啟自動推關」，正是指南要防的那件事。覆蓋率只算身上真的有裝備的部位（空部位面板值為 -1，雙手武器會讓 weapon2 永遠空著，算進分母的話門檻永遠到不了、閘門永久關閉）"
    },
    {
      "id": "equip-best-per-slot",
      "everySec": 15,
      "cmd": "item.equip",
      "bestPerSlot": {
        "items": "panels.inv.items",
        "equippedScores": "panels.inv.equipmentScores",
        "equipment": "panels.inv.equipment",
        "keepInvested": {
          "ancientOnly": false,
          "overrideRarityGap": 2,
          "說明": "身上這件的關鍵詞條要保住，除非候選裝等更高（overrideLevelGap，先判）或品質高 overrideRarityGap 階。裝等一定要先判：詞條數值 =（base + base×每級成長×(裝等−1)）× 品質倍率，裝等 1 的詞條只剩 base。只比品質的實測後果是 ring／ring2／amulet 三個部位 100 小時停在 R4 裝等 1，其餘九個部位早就 R5 裝等 100",
          "ancientOnly_為什麼是_false": "只保太古位置時，洗在普通位置上的關鍵詞條會被換裝丟掉。實測 4 個 seed：只保太古是 2/3/3 條（寶石鑲嵌/經驗/掉寶合計），全位置保護是 5/7/2 並出現第一個達標項。代價是成績下緣變差（等級最低 365→203、死亡中位約 53→99.5），中位等級 412→378.5 在 n=4 下算噪音。選 false 是取「像真人的配裝」而不是「最高分」",
          "overrideRarityGap_的作用": "防止保護變成永久凍結的閘。先前有一版保護綁在「缺口未補滿」上，目標達不到時永遠成立，實測 100 小時從關卡 190 掉到 117。品質高 2 階以上仍然換，凍結就有出口",
          "overrideLevelGap": 0
        }
      },
      "why": "換裝優先序：品質 >> 等級 >> 太古詞條數 >> 評分（player_strategy.md）。評分只當平手裁判——itemScore 把品質、等級、太古壓成一個數字，照它排會出現「品質低一階但詞條滾得好所以分數高」而換錯，而品質決定插槽數與附魔欄數，換不回來"
    },
    {
      "id": "upgrade-by-rarity-cap",
      "everySec": 15,
      "cmd": "item.upgrade",
      "why": "依品質分配強化資源：R0/R1 不強化，R2→+6，R3→+11，R4→+17，之後每階 +6；身上最高品質不設上限。低階裝要強到打得動下一段關卡（推不過去就掉不到好裝），但不能把材料砸在遲早換掉的裝備上——換掉時強化等級會一起消失",
      "upgradePriority": {
        "equippedRarities": "panels.inv.equipmentRarities",
        "equipment": "panels.inv.equipment",
        "capByRarity": [
          0,
          0,
          6,
          11,
          17,
          23,
          29,
          35,
          41,
          47,
          53
        ]
      }
    },
    {
      "id": "gem-convert",
      "everySec": 60,
      "cmd": "gem.convert",
      "convertToPreferred": {
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ],
            "依據": "前50級：爆擊率、爆擊傷害、生命、物理攻擊、魔法攻擊"
          },
          {
            "maxLevel": 100,
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "51~100級：暴擊率、爆擊傷害"
          },
          {
            "maxLevel": 200,
            "when": [
              "panels.header.stats.critRate",
              ">=",
              100
            ],
            "types": [
              "garnet"
            ],
            "依據": "101以後：全鑲孔基本全用爆擊傷害，前提爆率達100%"
          },
          {
            "maxLevel": 200,
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "101以後但爆率未達100%：先把爆率補上來"
          },
          {
            "when": [
              "panels.header.stats.critRate",
              ">=",
              100
            ],
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ],
            "依據": "201以後：爆傷邊際效益出現，一半換成元素屬性傷害加成寶石"
          },
          {
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "收尾段：爆率未達100%時繼續補爆擊"
          }
        ],
        "maxSlots": 9,
        "maxPerSlot": 1000,
        "maxCommands": 4,
        "quota": [
          {
            "type": "malachite",
            "count": 1,
            "依據": "物理/魔法抗性寶石依情況替換（打菁英或BOSS時）",
            "when": [
              "ctx.mode",
              "!=",
              "normal"
            ]
          },
          {
            "type": "fluorite",
            "count": 1,
            "依據": "物理/魔法抗性寶石依情況替換（打菁英或BOSS時）",
            "when": [
              "ctx.mode",
              "!=",
              "normal"
            ]
          },
          {
            "type": "kyanite",
            "count": 2,
            "when": [
              "view.mp",
              "<",
              {
                "$mul": [
                  {
                    "$path": "view.mpMax"
                  },
                  0.3
                ]
              }
            ],
            "依據": "法力恢復不夠者補法力恢復寶石至夠用"
          }
        ],
        "rebalance": [
          {
            "from": "garnet",
            "to": [
              "coreFire",
              "coreIce",
              "coreLightning",
              "corePoison",
              "coreLight",
              "coreDark"
            ],
            "when": [
              "view.level",
              ">=",
              201
            ],
            "toShare": 0.5,
            "minLevel": 6,
            "依據": "201以後把一半的爆傷寶石轉成元素屬性傷害加成寶石；只轉六級以上，低階的加成比爆傷還低"
          }
        ]
      },
      "why": "把不在當前偏好段的寶石同階轉成偏好種類。偏好種類只佔 40 種寶石裡的 5~7 種、掉落又隨機，光靠「挑有貨的鑲」永遠補不滿（實測 3 小時偏好種類只有 5/20 顆）。轉換在遊戲裡同階 1:1、數量不變、不花金幣（convertGems），是既有庫存的重新分配。排在 gem-compose 之前：先把同種類集中起來，合成才有 3 顆可併，鑲上去的階級才會跟著上去。配額種類（抗性、法力恢復）不轉走；目標在偏好種類間輪流分配，否則 101 段的「一半爆傷、一半屬性」會被轉成清一色爆傷。maxSlots/maxPerSlot 對應遊戲的 GEM_CONVERT_SLOTS/GEM_CONVERT_STACK，超過會整批被回絕"
    },
    {
      "id": "gem-compose",
      "everySec": 60,
      "cmd": "gem.composeAll",
      "expand": [
        {
          "key": "type",
          "path": "panels.gems.gems",
          "nonEmpty": true
        },
        {
          "key": "level",
          "values": [
            1,
            2,
            3,
            4
          ]
        }
      ],
      "why": "鑲嵌前先把寶石向上合成至當前可合成的最高品質（一般合成上限為 5 級，GEM_MAX_LEVEL；6 級以上只能由熔爐產出，送 5~9 階必被回絕故不送）。nonEmpty 只送手上真的有貨的種類——遊戲開局就把 40 種寶石建好且數量為 0"
    },
