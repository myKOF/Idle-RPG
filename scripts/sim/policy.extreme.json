  "rules": [
    {
      "id": "survival-gate",
      "everySec": 15,
      "cmd": "stage.setAutoAdvance",
      "stageGate": {
        "stage": "view.stage",
        "equippedRarities": "panels.inv.equipmentRarities",
        "argKey": "on",
        "checkpoints": [
          {
            "maxStage": 20,
            "minRarity": 2,
            "coverage": 1,
            "依據": "1. 前20關全身換成稀有裝再過20關守關菁英"
          },
          {
            "maxStage": 40,
            "minRarity": 3,
            "coverage": 1,
            "依據": "2+4. 21~29關掛機換獨特裝，第二目標40關守關菁英"
          },
          {
            "maxStage": 50,
            "minRarity": 4,
            "coverage": 0.3,
            "依據": "4. 41~49關掛機，全身至少一部份換到史詩才挑戰50關BOSS"
          },
          {
            "maxStage": 59,
            "minRarity": 4,
            "coverage": 1,
            "依據": "5. 通關50關BOSS後在51~59關掛機，全身換成史詩"
          },
          {
            "minRarity": 0,
            "coverage": 0,
            "依據": "指南只涵蓋前期（50級前生存引導），之後交回各強度自己的推關策略"
          }
        ]
      },
      "why": "依 player_strategy.md「前期優先生存任務指南」控制自動推關：裝備品質覆蓋率沒到門檻就關掉自動推關、留在原地掛機把裝備換上來。指南的核心是不要讓關卡跑在裝備前面——推太深只會一直死，死了就掉不到裝備，掉不到裝備就更推不動。先前是無條件每 15 秒送一次「開啟自動推關」，正是指南要防的那件事。覆蓋率只算身上真的有裝備的部位（空部位面板值為 -1，雙手武器會讓 weapon2 永遠空著，算進分母的話門檻永遠到不了、閘門永久關閉）"
    },
    {
      "id": "equip-best-per-slot",
      "everySec": 15,
      "cmd": "item.equip",
      "bestPerSlot": {
        "items": "panels.inv.items",
        "equippedScores": "panels.inv.equipmentScores"
      },
      "why": "每個部位換上背包裡評分最高且優於身上那件的裝備"
    },
    {
      "id": "upgrade-by-rarity-cap",
      "everySec": 15,
      "cmd": "item.upgrade",
      "why": "依品質分配強化資源：R0/R1 不強化，R2→+6，R3→+11，R4→+17，之後每階 +6；身上最高品質不設上限。低階裝要強到打得動下一段關卡（推不過去就掉不到好裝），但不能把材料砸在遲早換掉的裝備上——換掉時強化等級會一起消失",
      "upgradePriority": {
        "equippedRarities": "panels.inv.equipmentRarities",
        "equipment": "panels.inv.equipment",
        "capByRarity": [
          0,
          0,
          6,
          11,
          17,
          23,
          29,
          35,
          41,
          47,
          53
        ]
      }
    },
    {
      "id": "gem-convert",
      "everySec": 60,
      "cmd": "gem.convert",
      "convertToPreferred": {
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "topaz",
              "amethyst",
              "onyx",
              "ruby",
              "sapphire"
            ]
          },
          {
            "maxLevel": 100,
            "types": [
              "onyx",
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ]
          },
          {
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ]
          }
        ],
        "maxSlots": 9,
        "maxPerSlot": 1000,
        "maxCommands": 4
      },
      "why": "把不在當前偏好段的寶石同階轉成偏好種類。偏好種類只佔 40 種寶石裡的 5~7 種、掉落又隨機，光靠「挑有貨的鑲」永遠補不滿（實測 3 小時偏好種類只有 5/20 顆）。轉換在遊戲裡同階 1:1、數量不變、不花金幣（convertGems），是既有庫存的重新分配。排在 gem-compose 之前：先把同種類集中起來，合成才有 3 顆可併，鑲上去的階級才會跟著上去。目標在偏好種類間輪流分配，否則 101 段的「一半爆傷、一半屬性」會被轉成清一色爆傷。maxSlots/maxPerSlot 對應遊戲的 GEM_CONVERT_SLOTS/GEM_CONVERT_STACK，超過會整批被回絕"
    },
    {
      "id": "gem-compose",
      "everySec": 60,
      "cmd": "gem.composeAll",
      "expand": [
        {
          "key": "type",
          "path": "panels.gems.gems",
          "nonEmpty": true
        },
        {
          "key": "level",
          "values": [
            1,
            2,
            3,
            4
          ]
        }
      ],
      "why": "鑲嵌前先把寶石向上合成至當前可合成的最高品質（一般合成上限為 5 級，GEM_MAX_LEVEL；6 級以上只能由熔爐產出，送 5~9 階必被回絕故不送）。nonEmpty 只送手上真的有貨的種類——遊戲開局就把 40 種寶石建好且數量為 0"
    },
    {
      "id": "unsocket-off-priority",
      "everySec": 60,
      "cmd": "gem.unsocket",
      "unsocketOffPriority": {
        "equipment": "panels.inv.equipment",
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "topaz",
              "amethyst",
              "onyx",
              "ruby",
              "sapphire"
            ]
          },
          {
            "maxLevel": 100,
            "types": [
              "onyx",
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ]
          },
          {
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ]
          }
        ],
        "maxPerDecision": 2,
        "replaceWith": "gem.socket"
      },
      "why": "把不符當前偏好段、或階級低於庫存最高階的寶石換掉（拆與補在同一決策點成對送出）。socketEmpty 只填空槽，前期偏好種類還沒掉到時鑲上的雜牌會把插槽佔死（實測 3 小時後 12 個插槽偏好種類 0 顆），等級跨段時也不會有任何變化。只拆不補的話空槽會被 socket-gems 的退路重新塞回雜牌，變成每分鐘拆了又鑲。拆寶石在遊戲裡免費無損（unsocketGem 直接退回庫存），故為純重新配置；補不到偏好種類就完全不動，每次最多換 2 顆"
    },
    {
      "id": "socket-gems",
      "everySec": 60,
      "cmd": "gem.socket",
      "socketEmpty": {
        "equipment": "panels.inv.equipment",
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "topaz",
              "amethyst",
              "onyx",
              "ruby",
              "sapphire"
            ]
          },
          {
            "maxLevel": 100,
            "types": [
              "onyx",
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ]
          },
          {
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ]
          }
        ]
      },
      "why": "把寶石鑲進空插槽，依 player_strategy.md 寶石鑲嵌策略分段：前50級 生命→暴擊率→吸血→物攻→魔攻；51~100 吸血→暴擊率→爆傷→生命→物攻→魔攻；101以後 一半爆傷、一半六大屬性傷害加成（mix 兩組輪流）。手上沒有偏好種類就鑲任何有貨的；階級由遊戲挑（socketGem 取庫存最高階），所以本規則排在 gem-compose 之後，先合成再鑲就會鑲到當前可得的最高品質"
    },
    {
      "id": "reroll-off-target",
      "everySec": 300,
      "cmd": "item.rerollAffix",
      "rerollOffTarget": {
        "equipment": "panels.inv.equipment",
        "targetList": "targetAffixes",
        "minRarity": 3,
        "keepAncient": true
      },
      "why": "把不在 targetAffixes 的詞條洗掉（攻擊為主、防禦為輔）。精華少於 20 就不洗——實測精華是瓶頸，硬送只會得到 1,410 次「資源不足」把報表淹掉",
      "if": [
        [
          "view.essence",
          ">=",
          20
        ]
      ]
    },
    {
      "id": "enchant-equipped",
      "everySec": 300,
      "cmd": "item.enchant",
      "enchantPriority": {
        "equipment": "panels.inv.equipment",
        "enchantInfo": "panels.inv.equipmentEnchantInfo",
        "books": "panels.inv.books",
        "byCategory": {
          "util": [
            "vigor"
          ],
          "atk": [
            "ice"
          ],
          "def": [
            "fireRes",
            "iceRes",
            "lightningRes",
            "poisonRes",
            "lightRes",
            "darkRes"
          ]
        },
        "spread": [
          "def"
        ],
        "maxPerDecision": 4
      },
      "why": "依 player_strategy.md 附魔策略：生命值(vigor)→冰凍(ice)→六大屬性抗性平均。遊戲規定每個部位只吃一種類別（enchantCatForType：武器/戒指/手套/護腕＝攻擊，項鍊/鞋子＝功能，其餘＝防禦），所以這份優先序實際上是按類別分工而不是單一排序：功能部位放生命值、攻擊部位放冰凍、防禦部位放六大抗性並輪流分散。部位與類別的對應取自遊戲的面板欄位，策略不自己抄——抄一份遲早跟遊戲脫鉤，而 manualEnchant 只會回「XX 只能使用 OO 類附魔」，看報表不會發現規則從沒生效"
    },
    {
      "id": "auto-equip-on",
      "once": true,
      "cmd": "factory.setAutoEquip",
      "args": {
        "on": true
      },
      "why": "品質高優先穿：開啟自動換裝"
    },
    {
      "id": "buy-inv-upgrade",
      "everySec": 300,
      "if": [
        [
          "panels.inv.cap",
          "<",
          1000
        ]
      ],
      "cmd": "player.buyInvUpgrade",
      "why": "背包策略：穩定將背包逐步解鎖至1000格"
    },
    {
      "id": "add-furnace-max",
      "everySec": 300,
      "cmd": "newforge.addFurnace",
      "why": "熔爐解鎖到當前可開的最大數量"
    },
    {
      "id": "salvage-best-strategy",
      "once": true,
      "cmd": "newforge.setQuality",
      "argsList": [
        {
          "furnaceId": 1,
          "rarity": 0,
          "on": true
        },
        {
          "furnaceId": 1,
          "rarity": 1,
          "on": true
        }
      ],
      "why": "只拆解普通與優良(R0~R1)，稀有以上保留在背包當換裝候選"
    },
    {
      "id": "learn-potential-talents",
      "everySec": 15,
      "cmd": "talent.potentialUpgrade",
      "expand": [
        {
          "key": "id",
          "list": "skillPriority"
        }
      ],
      "why": "極速：潛力技能解鎖後優先潛力技能升級"
    },
    {
      "id": "learn-skills",
      "everySec": 10,
      "cmd": "skill.learn",
      "expand": [
        {
          "key": "id",
          "listByLevel": [
            {
              "maxLevel": 50,
              "list": "skillEarly"
            },
            {
              "maxLevel": 100,
              "list": "skillMid"
            },
            {
              "list": "skillLate"
            }
          ]
        }
      ],
      "why": "依 player_strategy.md 技能升級優先順序分段：前期(≤50)先點生命上限被動與護盾／持續恢復；中期(51~100)把被動技能全點滿；後期(101+)依裝備詞條方向（targetAffixes 為物理向）集中投物理。清單順序即投點優先序，點數不足時後面的由遊戲擋下"
    },
    {
      "id": "fuse-skills",
      "everySec": 300,
      "cmd": "skill.fuse",
      "why": "主動使用技能融合以強化技能"
    },
    {
      "id": "talent-upgrade-step1",
      "everySec": 30,
      "cmd": "talent.upgrade",
      "expand": [
        {
          "key": "id",
          "list": "talentStep1"
        }
      ],
      "why": "天賦策略：優先將1轉天賦全點滿"
    },
    {
      "id": "talent-upgrade-step2",
      "everySec": 30,
      "cmd": "talent.upgrade",
      "expand": [
        {
          "key": "id",
          "list": "talentStep2"
        }
      ],
      "why": "天賦策略：再將2轉天賦全點滿"
    },
    {
      "id": "talent-upgrade-step3",
      "everySec": 30,
      "cmd": "talent.upgrade",
      "expand": [
        {
          "key": "id",
          "list": "talentStep3"
        }
      ],
      "why": "天賦策略：再將3轉天賦全點滿"
    },
    {
      "id": "gem-shop-buy-1",
      "everySec": 1200,
      "cmd": "gem.shopBuyAll",
      "why": "每20分鐘買光所有商店寶石"
    },
    {
      "id": "gem-shop-refresh-8x",
      "everySec": 1200,
      "cmd": "gem.shopRefresh",
      "why": "重置寶石商店8次後再買光"
    },
    {
      "id": "gem-shop-buy-2",
      "everySec": 1200,
      "cmd": "gem.shopBuyAll",
      "why": "重置8次後再次買光"
    },
    {
      "id": "tower-auto",
      "everySec": 1200,
      "cmd": "tower.startAuto",
      "args": {
        "floor": {
          "$add": [
            {
              "$path": "panels.tower.tower.highest"
            },
            1
          ]
        },
        "count": 1
      },
      "why": "嘗試一次BOSS高塔挑戰"
    },
    {
      "id": "tower-finish-if-needed",
      "everySec": 30,
      "if": [
        [
          "panels.tower.tower.active",
          "truthy"
        ]
      ],
      "cmd": "tower.finish",
      "why": "高塔挑戰結束後回到一般場景戰鬥繼續遊玩"
    }
  ]
}
