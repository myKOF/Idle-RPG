{
  "name": "policy-extreme",
  "description": "極限玩家：24小時不間斷在線。採最佳技能與配裝策略(物理+吸血續戰+爆擊爆傷詞條+技能融合)，equip-best-per-slot自動換裝，全身11部位平均強化至+60，80%+6太古詞條+5菁英傷，寶石商店重置8次+掃光，極速潛力與技能融合，階梯點滿轉生天賦。穩定擴背包至1000格，R0~R1自動拆解，史詩以上裝備洗詞條",
  "decideEveryGameSec": 5,
  "dailyActiveHours": 24,
  "needPanels": [
    "tower",
    "gems",
    "newforge",
    "equip",
    "skills",
    "talents",
    "header",
    "inv"
  ],
  "lists": {
    "slotList": [
      "weapon",
      "helmet",
      "shoulder",
      "chest",
      "belt",
      "gloves",
      "wrist",
      "legs",
      "boots",
      "ring",
      "amulet"
    ],
    "skillPriority": [
      "vampirism",
      "healWound",
      "secondWind",
      "regenerate",
      "powerSlash",
      "doubleStrike",
      "sharpBlade",
      "toughness",
      "whirlwind",
      "swiftness",
      "armorBreak",
      "arcaneMind",
      "ironWall",
      "executeStrike",
      "berserkStrike",
      "rendWound",
      "brutality",
      "keenEye",
      "meditation",
      "stunBlow"
    ],
    "talentStep1": [
      "t1_str",
      "t1_agi",
      "t1_int",
      "t1_vit",
      "t1_def",
      "t1_mdef",
      "t1_pres",
      "t1_mres"
    ],
    "talentStep2": [
      "t2_crit",
      "t2_critdmg",
      "t2_hit",
      "t2_hp",
      "t2_shield",
      "t2_evasion",
      "t2_normalred",
      "t2_elitered"
    ],
    "talentStep3": [
      "t3_normal",
      "t3_elite",
      "t3_boss",
      "t3_potential",
      "t3_allres",
      "t3_def",
      "t3_mdef",
      "t3_allres2"
    ],
    "targetAffixes": [
      "patk",
      "lifesteal",
      "critDmg",
      "crit",
      "gemEff",
      "xpGain",
      "dropRate",
      "eliteDmg"
    ]
  },
  "rules": [
    {
      "id": "equip-best-per-slot",
      "everySec": 15,
      "cmd": "item.equip",
      "bestPerSlot": {
        "items": "panels.inv.items",
        "equippedScores": "panels.inv.equipmentScores"
      },
      "why": "每個部位換上背包裡評分最高且優於身上那件的裝備"
    },
    {
      "id": "upgrade-by-rarity-cap",
      "everySec": 15,
      "cmd": "item.upgrade",
      "why": "依品質分配強化資源：R0/R1 不強化，R2→+6，R3→+11，R4→+17，之後每階 +6；身上最高品質不設上限。低階裝要強到打得動下一段關卡（推不過去就掉不到好裝），但不能把材料砸在遲早換掉的裝備上——換掉時強化等級會一起消失",
      "upgradePriority": {
        "equippedRarities": "panels.inv.equipmentRarities",
        "equipment": "panels.inv.equipment",
        "capByRarity": [
          0,
          0,
          6,
          11,
          17,
          23,
          29,
          35,
          41,
          47,
          53
        ]
      }
    },
    {
      "id": "auto-equip-on",
      "once": true,
      "cmd": "factory.setAutoEquip",
      "args": {
        "on": true
      },
      "why": "品質高優先穿：開啟自動換裝"
    },
    {
      "id": "auto-advance-init-on",
      "everySec": 15,
      "cmd": "stage.setAutoAdvance",
      "args": {
        "on": true
      },
      "why": "持續保持自動推關勾選狀態"
    },
    {
      "id": "buy-inv-upgrade",
      "everySec": 300,
      "if": [
        [
          "panels.inv.cap",
          "<",
          1000
        ]
      ],
      "cmd": "player.buyInvUpgrade",
      "why": "背包策略：穩定將背包逐步解鎖至1000格"
    },
    {
      "id": "add-furnace-max",
      "everySec": 300,
      "cmd": "newforge.addFurnace",
      "why": "熔爐解鎖到當前可開的最大數量"
    },
    {
      "id": "salvage-best-strategy",
      "once": true,
      "cmd": "newforge.setQuality",
      "argsList": [
        {
          "furnaceId": 1,
          "rarity": 0,
          "on": true
        },
        {
          "furnaceId": 1,
          "rarity": 1,
          "on": true
        }
      ],
      "why": "只拆解普通與優良(R0~R1)，稀有以上保留在背包當換裝候選"
    },
    {
      "id": "reroll-jewel-amulet",
      "everySec": 60,
      "if": [
        [
          "panels.equip.equipment.amulet",
          "truthy"
        ],
        [
          "panels.equip.equipment.amulet.rarity",
          ">=",
          3
        ]
      ],
      "cmd": "item.rerollAffix",
      "expand": [
        {
          "key": "affixKey",
          "list": "targetAffixes"
        }
      ],
      "args": {
        "itemId": {
          "$path": "panels.equip.equipment.amulet.id"
        },
        "affixKey": {
          "$arg": "affixKey"
        }
      },
      "why": "飾品達到史詩以上才進行洗煉，加入吸血lifesteal詞條提升續戰力"
    },
    {
      "id": "reroll-jewel-ring",
      "everySec": 60,
      "if": [
        [
          "panels.equip.equipment.ring",
          "truthy"
        ],
        [
          "panels.equip.equipment.ring.rarity",
          ">=",
          3
        ]
      ],
      "cmd": "item.rerollAffix",
      "expand": [
        {
          "key": "affixKey",
          "list": "targetAffixes"
        }
      ],
      "args": {
        "itemId": {
          "$path": "panels.equip.equipment.ring.id"
        },
        "affixKey": {
          "$arg": "affixKey"
        }
      },
      "why": "戒指達到史詩以上才進行洗煉，加入吸血lifesteal詞條提升續戰力"
    },
    {
      "id": "learn-potential-talents",
      "everySec": 15,
      "cmd": "talent.potentialUpgrade",
      "expand": [
        {
          "key": "id",
          "list": "skillPriority"
        }
      ],
      "why": "極速：潛力技能解鎖後優先潛力技能升級"
    },
    {
      "id": "learn-skills",
      "everySec": 10,
      "cmd": "skill.learn",
      "expand": [
        {
          "key": "id",
          "list": "skillPriority"
        }
      ],
      "why": "集中升級吸血與恢復技能(vampirism, healWound, secondWind, regenerate)及物理攻擊技能"
    },
    {
      "id": "fuse-skills",
      "everySec": 300,
      "cmd": "skill.fuse",
      "why": "主動使用技能融合以強化技能"
    },
    {
      "id": "talent-upgrade-step1",
      "everySec": 30,
      "cmd": "talent.upgrade",
      "expand": [
        {
          "key": "id",
          "list": "talentStep1"
        }
      ],
      "why": "天賦策略：優先將1轉天賦全點滿"
    },
    {
      "id": "talent-upgrade-step2",
      "everySec": 30,
      "cmd": "talent.upgrade",
      "expand": [
        {
          "key": "id",
          "list": "talentStep2"
        }
      ],
      "why": "天賦策略：再將2轉天賦全點滿"
    },
    {
      "id": "talent-upgrade-step3",
      "everySec": 30,
      "cmd": "talent.upgrade",
      "expand": [
        {
          "key": "id",
          "list": "talentStep3"
        }
      ],
      "why": "天賦策略：再將3轉天賦全點滿"
    },
    {
      "id": "gem-shop-buy-1",
      "everySec": 1200,
      "cmd": "gem.shopBuyAll",
      "why": "每20分鐘買光所有商店寶石"
    },
    {
      "id": "gem-shop-refresh-8x",
      "everySec": 1200,
      "cmd": "gem.shopRefresh",
      "why": "重置寶石商店8次後再買光"
    },
    {
      "id": "gem-shop-buy-2",
      "everySec": 1200,
      "cmd": "gem.shopBuyAll",
      "why": "重置8次後再次買光"
    },
    {
      "id": "gem-compose",
      "everySec": 600,
      "cmd": "gem.composeAll",
      "expand": [
        {
          "key": "type",
          "path": "panels.gems.gems"
        },
        {
          "key": "level",
          "values": [
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            9
          ]
        }
      ],
      "why": "每10分鐘自動將寶石向上合成至10級"
    },
    {
      "id": "tower-auto",
      "everySec": 1200,
      "cmd": "tower.startAuto",
      "args": {
        "floor": {
          "$add": [
            {
              "$path": "panels.tower.tower.highest"
            },
            1
          ]
        },
        "count": 1
      },
      "why": "嘗試一次BOSS高塔挑戰"
    },
    {
      "id": "tower-finish-if-needed",
      "everySec": 30,
      "if": [
        [
          "panels.tower.tower.active",
          "truthy"
        ]
      ],
      "cmd": "tower.finish",
      "why": "高塔挑戰結束後回到一般場景戰鬥繼續遊玩"
    }
  ]
}
