{
  "name": "policy-light",
  "description": "輕度玩家：每日遊玩2小時，其餘離線。採最佳技能與配裝策略(物理+吸血續戰+爆擊爆傷詞條+技能融合)，equip-best-per-slot自動換裝，全身11部位平均強化至+20，寶石目標全身5級爆傷，不買商店，10分鐘高塔與寶石合成。採最佳分解策略(R0~R1)，穩定擴背包至300格",
  "decideEveryGameSec": 60,
  "dailyActiveHours": 2,
  "needPanels": ["tower", "gems", "newforge", "equip", "header", "inv"],
  "lists": {
    "skillPriority": [
      "vampirism", "healWound", "secondWind", "regenerate", "powerSlash",
      "doubleStrike", "sharpBlade", "toughness", "whirlwind", "swiftness",
      "armorBreak", "arcaneMind", "ironWall"
    ]
  },
  "rules": [
    {
      "id": "equip-best-per-slot",
      "everySec": 15,
      "cmd": "item.equip",
      "bestPerSlot": {
        "items": "panels.inv.items",
        "equippedScores": "panels.inv.equipmentScores"
      },
      "why": "每個部位換上背包裡評分最高且優於身上那件的裝備"
    },
    {
      "id": "auto-equip-on",
      "once": true,
      "cmd": "factory.setAutoEquip",
      "args": { "on": true },
      "why": "品質高優先穿：開啟自動換裝"
    },
    {
      "id": "auto-advance-init-on",
      "everySec": 15,
      "cmd": "stage.setAutoAdvance",
      "args": { "on": true },
      "why": "持續保持自動推關勾選狀態"
    },

    {
      "id": "buy-inv-upgrade",
      "everySec": 600,
      "if": [["panels.inv.cap", "<", 300]],
      "cmd": "player.buyInvUpgrade",
      "why": "背包策略：穩定將背包逐步解鎖至300格"
    },

    {
      "id": "add-furnace-2",
      "once": true,
      "cmd": "newforge.addFurnace",
      "why": "輕度玩家：熔爐開兩個"
    },
    {
      "id": "salvage-best-strategy",
      "once": true,
      "cmd": "newforge.setQuality",
      "argsList": [
        { "furnaceId": 1, "rarity": 0, "on": true },
        { "furnaceId": 1, "rarity": 1, "on": true }
      ],
      "why": "只拆解普通與優良(R0~R1)，稀有以上保留在背包當換裝候選"
    },

    {
      "id": "upgrade-all-equips-weapon",
      "everySec": 120,
      "if": [["panels.equip.equipment.weapon", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.weapon.id" } },
      "why": "全身平均強化：主手武器"
    },
    {
      "id": "upgrade-all-equips-chest",
      "everySec": 120,
      "if": [["panels.equip.equipment.chest", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.chest.id" } },
      "why": "全身平均強化：胸甲"
    },
    {
      "id": "upgrade-all-equips-helmet",
      "everySec": 120,
      "if": [["panels.equip.equipment.helmet", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.helmet.id" } },
      "why": "全身平均強化：頭盔"
    },
    {
      "id": "upgrade-all-equips-shoulder",
      "everySec": 120,
      "if": [["panels.equip.equipment.shoulder", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.shoulder.id" } },
      "why": "全身平均強化：肩甲"
    },
    {
      "id": "upgrade-all-equips-gloves",
      "everySec": 120,
      "if": [["panels.equip.equipment.gloves", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.gloves.id" } },
      "why": "全身平均強化：手套"
    },
    {
      "id": "upgrade-all-equips-wrist",
      "everySec": 120,
      "if": [["panels.equip.equipment.wrist", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.wrist.id" } },
      "why": "全身平均強化：護腕"
    },
    {
      "id": "upgrade-all-equips-legs",
      "everySec": 120,
      "if": [["panels.equip.equipment.legs", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.legs.id" } },
      "why": "全身平均強化：腿甲"
    },
    {
      "id": "upgrade-all-equips-boots",
      "everySec": 120,
      "if": [["panels.equip.equipment.boots", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.boots.id" } },
      "why": "全身平均強化：靴子"
    },
    {
      "id": "upgrade-all-equips-ring",
      "everySec": 120,
      "if": [["panels.equip.equipment.ring", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.ring.id" } },
      "why": "全身平均強化：戒指"
    },
    {
      "id": "upgrade-all-equips-amulet",
      "everySec": 120,
      "if": [["panels.equip.equipment.amulet", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.amulet.id" } },
      "why": "全身平均強化：項鍊"
    },

    {
      "id": "gem-compose",
      "everySec": 600,
      "cmd": "gem.composeAll",
      "expand": [
        { "key": "type", "path": "panels.gems.gems" },
        { "key": "level", "values": [1, 2, 3, 4] }
      ],
      "why": "每10分鐘自動將寶石向上合成至5級爆傷寶石"
    },

    {
      "id": "learn-skills",
      "everySec": 60,
      "cmd": "skill.learn",
      "expand": [{ "key": "id", "list": "skillPriority" }],
      "why": "集中升級吸血與回復技能(vampirism, healWound, secondWind, regenerate)及物理攻擊技能"
    },
    {
      "id": "fuse-skills",
      "everySec": 1200,
      "cmd": "skill.fuse",
      "why": "主動使用技能融合以強化技能"
    },

    {
      "id": "tower-auto",
      "everySec": 600,
      "cmd": "tower.startAuto",
      "args": {
        "floor": { "$add": [{ "$path": "panels.tower.tower.highest" }, 1] },
        "count": 1
      },
      "why": "每10分鐘嘗試一次BOSS高塔挑戰，打到失敗即停止"
    },
    {
      "id": "tower-finish-if-needed",
      "everySec": 60,
      "if": [["panels.tower.tower.active", "truthy"]],
      "cmd": "tower.finish",
      "why": "回到一般場景戰鬥繼續遊玩"
    }
  ]
}
