{
  "name": "policy-light",
  "description": "輕度玩家：每日遊玩2小時，其餘離線。強化上限+20，寶石目標全身5級爆傷，不買商店，10分鐘高塔與寶石合成。退回安全關卡時關閉自動推關穩定掛機，強度提升後重新勾選並挑戰最高關卡",
  "decideEveryGameSec": 60,
  "dailyActiveHours": 2,
  "needPanels": ["tower", "gems", "newforge", "equip", "header"],
  "lists": {
    "skillPriority": [
      "powerSlash", "doubleStrike", "sharpBlade", "toughness", "whirlwind",
      "swiftness", "armorBreak", "arcaneMind", "healWound", "ironWall"
    ]
  },
  "rules": [
    {
      "id": "auto-equip-on",
      "once": true,
      "cmd": "factory.setAutoEquip",
      "args": { "on": true },
      "why": "品質高優先穿：開啟自動換裝"
    },
    {
      "id": "auto-advance-init-on",
      "once": true,
      "cmd": "stage.setAutoAdvance",
      "args": { "on": true },
      "why": "開局保持自動推關勾選狀態"
    },

    {
      "id": "disable-autoadvance-on-retreat",
      "everySec": 60,
      "if": [["panels.header.stage.current", "<", { "$path": "panels.header.stage.best" }]],
      "cmd": "stage.setAutoAdvance",
      "args": { "on": false },
      "why": "發現關卡打不過退回安全關卡時，將自動推關關閉以維持穩定掛機"
    },
    {
      "id": "enable-autoadvance-and-push",
      "everySec": 600,
      "cmd": "stage.setAutoAdvance",
      "args": { "on": true },
      "why": "人物強度提升後，重新勾選自動推關以嘗試更高關卡推進"
    },
    {
      "id": "push-max-stage",
      "everySec": 600,
      "cmd": "stage.goMax",
      "why": "人物強度提升後，切換至最高關卡嘗試推進"
    },

    {
      "id": "add-furnace-2",
      "once": true,
      "cmd": "newforge.addFurnace",
      "why": "輕度玩家：熔爐開兩個"
    },
    {
      "id": "salvage-low-rarity",
      "once": true,
      "cmd": "newforge.setQuality",
      "argsList": [
        { "furnaceId": 1, "rarity": 0, "on": true },
        { "furnaceId": 1, "rarity": 1, "on": true }
      ],
      "why": "分解普通與優良品質裝備"
    },

    {
      "id": "upgrade-weapon",
      "everySec": 120,
      "if": [["panels.equip.equipment.weapon", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.weapon.id" } },
      "why": "平均強化至+20：強化主手武器"
    },
    {
      "id": "upgrade-chest",
      "everySec": 120,
      "if": [["panels.equip.equipment.chest", "truthy"]],
      "cmd": "item.upgrade",
      "args": { "itemId": { "$path": "panels.equip.equipment.chest.id" } },
      "why": "平均強化至+20：強化胸甲"
    },

    {
      "id": "gem-compose",
      "everySec": 600,
      "cmd": "gem.composeAll",
      "expand": [
        { "key": "type", "path": "panels.gems.gems" },
        { "key": "level", "values": [1, 2, 3, 4] }
      ],
      "why": "每10分鐘自動將寶石向上合成至5級爆傷寶石"
    },

    {
      "id": "learn-skills",
      "everySec": 60,
      "cmd": "skill.learn",
      "expand": [{ "key": "id", "list": "skillPriority" }],
      "why": "只要有技能點就升級技能，主動技與被動技並重"
    },

    {
      "id": "tower-auto",
      "everySec": 600,
      "cmd": "tower.startAuto",
      "args": {
        "floor": { "$add": [{ "$path": "panels.tower.tower.highest" }, 1] },
        "count": 1
      },
      "why": "每10分鐘嘗試一次BOSS高塔挑戰，打到失敗即停止"
    },
    {
      "id": "tower-finish-if-needed",
      "everySec": 60,
      "if": [["panels.tower.tower.active", "truthy"]],
      "cmd": "tower.finish",
      "why": "回到一般場景戰鬥繼續遊玩"
    }
  ]
}
