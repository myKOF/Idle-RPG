  "rules": [
    {
      "id": "survival-gate",
      "everySec": 15,
      "cmd": "stage.setAutoAdvance",
      "stageGate": {
        "stage": "view.stage",
        "equippedRarities": "panels.inv.equipmentRarities",
        "dropRates": "panels.battle.dropRates",
        "dropRates_依據": "當前這一關掉得出哪些品質，由遊戲的 fieldDropRatesFor 回答。品質門檻達不成時放行，避免站在原地等一個掉不出來的品質（詳細事故說明見 policy.extreme.roi.json 的同名欄位與 policy_interpreter.js 的註解）",
        "argKey": "on",
        "checkpoints": [
          {
            "maxStage": 20,
            "minRarity": 2,
            "coverage": 0.85,
            "park": [
              11,
              15
            ],
            "依據": "指南1＋安全關卡1. 前20關在11~15關刷到全身稀有"
          },
          {
            "maxStage": 40,
            "minRarity": 3,
            "coverage": 0.85,
            "park": [
              21,
              25
            ],
            "依據": "指南2＋安全關卡2. 過20關菁英後在21~25關刷到全身獨特"
          },
          {
            "maxStage": 50,
            "minRarity": 4,
            "coverage": 0.3,
            "park": [
              41,
              45
            ],
            "依據": "指南4＋安全關卡3. 過40關菁英後在41~45關刷到一部份史詩"
          },
          {
            "maxStage": 59,
            "minRarity": 4,
            "coverage": 0.85,
            "park": [
              51,
              59
            ],
            "依據": "指南5＋安全關卡4. 過50關BOSS後在51~59關刷到全身史詩"
          },
          {
            "minRarity": 0,
            "coverage": 0,
            "依據": "指南只涵蓋前期，之後交回各強度自己的推關策略"
          }
        ],
        "retreatCmd": "stage.go"
      },
      "為什麼沒有掛產出閘門": "試過而且量過：閘門機制（stageGate.requireTargets + targetRetreat，以每分鐘擊殺數當安全關卡判準）已實作並有測試，但四種門檻在 4 個 seed 上全部輸給不設閘門——中位關卡 160.5 → 136~145.5，最高關卡 200 → 150~160。原因是離線收益算的是 offlineStageFor(G.stage.best)，而菁英怪單殺經驗隨關卡指數成長、升級所需經驗只是多項式成長，所以「推得深」的價值遠大於「殺得快」。退關雖然不會讓 best 縮水，卻要花在線時間重爬。詳見 docs/SIM_HARNESS.md「產出閘門：量對了指標，卻是錯的目標」",
      "why": "依 player_strategy.md「前期優先生存任務指南」控制自動推關：裝備品質覆蓋率沒到門檻就關掉自動推關、留在原地掛機把裝備換上來。指南的核心是不要讓關卡跑在裝備前面——推太深只會一直死，死了就掉不到裝備，掉不到裝備就更推不動。先前是無條件每 15 秒送一次「開啟自動推關」，正是指南要防的那件事。覆蓋率只算身上真的有裝備的部位（空部位面板值為 -1，雙手武器會讓 weapon2 永遠空著，算進分母的話門檻永遠到不了、閘門永久關閉）"
    },
    {
      "id": "equip-set-switch",
      "everySec": 60,
      "cmd": "player.switchEquipSet",
      "equipSetSwitch": {
        "panel": "panels.equipSets",
        "stage": "view.stage",
        "towerActive": "panels.tower.tower.active",
        "home": 0,
        "minFilled": 10,
        "tower": {
          "set": 1
        },
        "boss": {
          "every": 50,
          "ahead": 3,
          "set": 1
        },
        "elite": {
          "every": 10,
          "ahead": 3,
          "set": 2
        },
        "confirm": 2
      },
      "why": "player_strategy.md §7：平時第 1 套；推關時依「離下一個菁英／BOSS 關還有幾關」在抵達前先換——決策點約每分鐘一次，而推關時一分鐘跳好幾關，等怪物出現才反應會來不及。封魔塔用第 2 套。那一套沒建好（<minFilled 格）就不切"
    },
    {
      "id": "equip-best-per-slot",
      "everySec": 15,
      "cmd": "item.equip",
      "bestPerSlot": {
        "items": "panels.inv.items",
        "equippedScores": "panels.inv.equipmentScores",
        "equipment": "panels.inv.equipment",
        "blocked": "panels.equipRules.blocked"
      },
      "why": "換裝優先序：品質 >> 等級 >> 太古詞條數 >> 評分（player_strategy.md）。評分只當平手裁判——itemScore 把品質、等級、太古壓成一個數字，照它排會出現「品質低一階但詞條滾得好所以分數高」而換錯，而品質決定插槽數與附魔欄數，換不回來"
    },
    {
      "id": "equip-set-build",
      "everySec": 120,
      "cmd": "item.equip",
      "equipSetBuild": {
        "panel": "panels.equipSets",
        "maxPerDecision": 4,
        "gear": {
          "minRarity": 4,
          "coverage": 0.85,
          "minFilled": 10
        }
      },
      "why": "player_strategy.md §7：第 2、3 套只用「第 1 套不要的」裝備（候選比第 1 套現有的還好就留給第 1 套），且前一套品質覆蓋達標才建下一套（有餘力才弄）。不為它們另外強化"
    },
    {
      "id": "upgrade-by-rarity-cap",
      "everySec": 30,
      "cmd": "item.upgrade",
      "why": "依品質分配強化資源：R0/R1 不強化，R2→+6，R3→+11，R4→+17，之後每階 +6；身上最高品質不設上限。低階裝要強到打得動下一段關卡（推不過去就掉不到好裝），但不能把材料砸在遲早換掉的裝備上——換掉時強化等級會一起消失",
      "upgradePriority": {
        "equippedRarities": "panels.inv.equipmentRarities",
        "equipment": "panels.inv.equipment",
        "capByRarity": [
          0,
          0,
          6,
          11,
          17,
          23,
          29,
          35,
          41,
          47,
          53
        ]
      }
    },
    {
      "id": "gem-convert",
      "everySec": 60,
      "cmd": "gem.convert",
      "convertToPreferred": {
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ],
            "依據": "前50級：爆擊率、爆擊傷害、生命、物理攻擊、魔法攻擊"
          },
          {
            "maxLevel": 100,
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "51~100級：暴擊率、爆擊傷害"
          },
          {
            "maxLevel": 200,
            "when": [
              "panels.header.stats.critRate",
              ">=",
              100
            ],
            "types": [
              "garnet"
            ],
            "依據": "101以後：全鑲孔基本全用爆擊傷害，前提爆率達100%"
          },
          {
            "maxLevel": 200,
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "101以後但爆率未達100%：先把爆率補上來"
          },
          {
            "when": [
              "panels.header.stats.critRate",
              ">=",
              100
            ],
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ],
            "依據": "201以後：爆傷邊際效益出現，一半換成元素屬性傷害加成寶石"
          },
          {
            "types": [
              "amethyst",
              "garnet"
            ],
            "依據": "收尾段：爆率未達100%時繼續補爆擊"
          }
        ],
        "maxSlots": 9,
        "maxPerSlot": 1000,
        "maxCommands": 4,
        "quota": [
          {
            "type": "malachite",
            "count": 1,
            "依據": "物理/魔法抗性寶石依情況替換（打菁英或BOSS時）",
            "when": [
              "ctx.mode",
              "!=",
              "normal"
            ]
          },
          {
            "type": "fluorite",
            "count": 1,
            "依據": "物理/魔法抗性寶石依情況替換（打菁英或BOSS時）",
            "when": [
              "ctx.mode",
              "!=",
              "normal"
            ]
          },
          {
            "type": "kyanite",
            "count": 2,
            "when": [
              "view.mp",
              "<",
              {
                "$mul": [
                  {
                    "$path": "view.mpMax"
                  },
                  0.3
                ]
              }
            ],
            "依據": "法力恢復不夠者補法力恢復寶石至夠用"
          }
        ],
        "rebalance": [
          {
            "from": "garnet",
            "to": [
              "coreFire",
              "coreIce",
              "coreLightning",
              "corePoison",
              "coreLight",
              "coreDark"
            ],
            "when": [
              "view.level",
              ">=",
              201
            ],
            "toShare": 0.5,
            "minLevel": 6,
            "依據": "201以後把一半的爆傷寶石轉成元素屬性傷害加成寶石；只轉六級以上，低階的加成比爆傷還低"
          }
        ]
      },
      "why": "把不在當前偏好段的寶石同階轉成偏好種類。偏好種類只佔 40 種寶石裡的 5~7 種、掉落又隨機，光靠「挑有貨的鑲」永遠補不滿（實測 3 小時偏好種類只有 5/20 顆）。轉換在遊戲裡同階 1:1、數量不變、不花金幣（convertGems），是既有庫存的重新分配。排在 gem-compose 之前：先把同種類集中起來，合成才有 3 顆可併，鑲上去的階級才會跟著上去。配額種類（抗性、法力恢復）不轉走；目標在偏好種類間輪流分配，否則 101 段的「一半爆傷、一半屬性」會被轉成清一色爆傷。maxSlots/maxPerSlot 對應遊戲的 GEM_CONVERT_SLOTS/GEM_CONVERT_STACK，超過會整批被回絕"
    },
    {
      "id": "gem-compose",
      "everySec": 60,
      "cmd": "gem.composeAll",
      "expand": [
        {
          "key": "type",
          "path": "panels.gems.gems",
          "nonEmpty": true
        },
        {
          "key": "level",
          "values": [
            1,
            2,
            3,
            4
          ]
        }
      ],
      "why": "鑲嵌前先把寶石向上合成至當前可合成的最高品質（一般合成上限為 5 級，GEM_MAX_LEVEL；6 級以上只能由熔爐產出，送 5~9 階必被回絕故不送）。nonEmpty 只送手上真的有貨的種類——遊戲開局就把 40 種寶石建好且數量為 0"
    },
