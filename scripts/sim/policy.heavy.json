{
  "name": "policy-heavy",
  "description": "重度玩家：每日遊玩8小時。採最佳技能與配裝策略(物理+吸血續戰+爆擊爆傷詞條+技能融合)，equip-best-per-slot自動換裝，全身11部位平均強化至+50，詞條75%+2太古+首飾保證2鑲嵌/2經驗/2掉寶+3菁英傷，金幣充裕升級商店，每20分鐘掃商店+重置5次，優先潛力技能與技能融合，階梯式點滿轉生天賦。穩定擴背包至700格，R0~R1自動拆解，史詩以上裝備洗詞條",
  "decideEveryGameSec": 15,
  "dailyActiveHours": 8,
  "needPanels": [
    "tower",
    "gems",
    "newforge",
    "equip",
    "skills",
    "talents",
    "header",
    "inv"
  ],
  "lists": {
    "talentStep1": [
      "t1_str",
      "t1_agi",
      "t1_int",
      "t1_vit",
      "t1_def",
      "t1_mdef",
      "t1_pres",
      "t1_mres"
    ],
    "talentStep2": [
      "t2_crit",
      "t2_critdmg",
      "t2_hit",
      "t2_hp",
      "t2_shield",
      "t2_evasion",
      "t2_normalred",
      "t2_elitered"
    ],
    "targetAffixes": [
      "atkPct",
      "atkFlat",
      "critRate",
      "critDmg",
      "aspd",
      "pPen",
      "lifesteal",
      "eliteDmg",
      "bossDmg",
      "gemEff",
      "xpBonus",
      "loot"
    ],
    "skillEarly": [
      "toughness",
      "manaBarrier",
      "regenerate",
      "healWound",
      "secondWind",
      "vampirism",
      "sharpBlade",
      "powerSlash",
      "doubleStrike",
      "whirlwind",
      "armorBreak"
    ],
    "skillMid": [
      "toughness",
      "sharpBlade",
      "keenEye",
      "brutality",
      "vampirism",
      "swiftness",
      "ironSkin",
      "fortuneFavor",
      "phantomEcho",
      "meditation",
      "reaperTempo",
      "battleReflex",
      "zeroCadence",
      "afterimagePursuit",
      "bulwarkFeedback",
      "huntSigil",
      "lingeringGlow",
      "virulentPulse",
      "arcaneMind",
      "manaBarrier",
      "regenerate",
      "healWound",
      "secondWind"
    ],
    "skillLate": [
      "sharpBlade",
      "keenEye",
      "brutality",
      "swiftness",
      "vampirism",
      "toughness",
      "powerSlash",
      "doubleStrike",
      "whirlwind",
      "armorBreak",
      "executeStrike",
      "rendWound",
      "stunBlow",
      "berserkStrike",
      "preciseThrust",
      "heavySmash",
      "swiftCuts",
      "counterStance",
      "soulBrandFlurry",
      "sinDetonate",
      "echoBlade",
      "warSpiritEngine",
      "pursuitDecree",
      "warOverture",
      "woundCollapse",
      "mindflowChain",
      "swordDomain",
      "phantomEcho",
      "reaperTempo",
      "battleReflex",
      "zeroCadence",
      "afterimagePursuit",
      "huntSigil",
      "manaBarrier",
      "regenerate",
      "healWound",
      "secondWind"
    ]
  },
  "rules": [
    {
      "id": "equip-best-per-slot",
      "everySec": 15,
      "cmd": "item.equip",
      "bestPerSlot": {
        "items": "panels.inv.items",
        "equippedScores": "panels.inv.equipmentScores"
      },
      "why": "每個部位換上背包裡評分最高且優於身上那件的裝備"
    },
    {
      "id": "upgrade-by-rarity-cap",
      "everySec": 30,
      "cmd": "item.upgrade",
      "why": "依品質分配強化資源：R0/R1 不強化，R2→+6，R3→+11，R4→+17，之後每階 +6；身上最高品質不設上限。低階裝要強到打得動下一段關卡（推不過去就掉不到好裝），但不能把材料砸在遲早換掉的裝備上——換掉時強化等級會一起消失",
      "upgradePriority": {
        "equippedRarities": "panels.inv.equipmentRarities",
        "equipment": "panels.inv.equipment",
        "capByRarity": [
          0,
          0,
          6,
          11,
          17,
          23,
          29,
          35,
          41,
          47,
          53
        ]
      }
    },
    {
      "id": "gem-compose",
      "everySec": 60,
      "cmd": "gem.composeAll",
      "expand": [
        {
          "key": "type",
          "path": "panels.gems.gems",
          "nonEmpty": true
        },
        {
          "key": "level",
          "values": [
            1,
            2,
            3,
            4
          ]
        }
      ],
      "why": "鑲嵌前先把寶石向上合成至當前可合成的最高品質（一般合成上限為 5 級，GEM_MAX_LEVEL；6 級以上只能由熔爐產出，送 5~9 階必被回絕故不送）。nonEmpty 只送手上真的有貨的種類——遊戲開局就把 40 種寶石建好且數量為 0"
    },
    {
      "id": "unsocket-off-priority",
      "everySec": 60,
      "cmd": "gem.unsocket",
      "unsocketOffPriority": {
        "equipment": "panels.inv.equipment",
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "topaz",
              "amethyst",
              "onyx",
              "ruby",
              "sapphire"
            ]
          },
          {
            "maxLevel": 100,
            "types": [
              "onyx",
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ]
          },
          {
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ]
          }
        ],
        "maxPerDecision": 2,
        "replaceWith": "gem.socket"
      },
      "why": "把不符當前偏好段、或階級低於庫存最高階的寶石換掉（拆與補在同一決策點成對送出）。socketEmpty 只填空槽，前期偏好種類還沒掉到時鑲上的雜牌會把插槽佔死（實測 3 小時後 12 個插槽偏好種類 0 顆），等級跨段時也不會有任何變化。只拆不補的話空槽會被 socket-gems 的退路重新塞回雜牌，變成每分鐘拆了又鑲。拆寶石在遊戲裡免費無損（unsocketGem 直接退回庫存），故為純重新配置；補不到偏好種類就完全不動，每次最多換 2 顆"
    },
    {
      "id": "socket-gems",
      "everySec": 60,
      "cmd": "gem.socket",
      "socketEmpty": {
        "equipment": "panels.inv.equipment",
        "gems": "panels.gems.gems",
        "levelPath": "view.level",
        "preferByLevel": [
          {
            "maxLevel": 50,
            "types": [
              "topaz",
              "amethyst",
              "onyx",
              "ruby",
              "sapphire"
            ]
          },
          {
            "maxLevel": 100,
            "types": [
              "onyx",
              "amethyst",
              "garnet",
              "topaz",
              "ruby",
              "sapphire"
            ]
          },
          {
            "mix": [
              [
                "garnet"
              ],
              [
                "coreFire",
                "coreIce",
                "coreLightning",
                "corePoison",
                "coreLight",
                "coreDark"
              ]
            ]
          }
        ]
      },
      "why": "把寶石鑲進空插槽，依 player_strategy.md 寶石鑲嵌策略分段：前50級 生命→暴擊率→吸血→物攻→魔攻；51~100 吸血→暴擊率→爆傷→生命→物攻→魔攻；101以後 一半爆傷、一半六大屬性傷害加成（mix 兩組輪流）。手上沒有偏好種類就鑲任何有貨的；階級由遊戲挑（socketGem 取庫存最高階），所以本規則排在 gem-compose 之後，先合成再鑲就會鑲到當前可得的最高品質"
    },
    {
      "id": "reroll-off-target",
      "everySec": 300,
      "cmd": "item.rerollAffix",
      "rerollOffTarget": {
        "equipment": "panels.inv.equipment",
        "targetList": "targetAffixes",
        "minRarity": 3,
        "keepAncient": true
      },
      "why": "把不在 targetAffixes 的詞條洗掉（攻擊為主、防禦為輔）。精華少於 20 就不洗——實測精華是瓶頸，硬送只會得到 1,410 次「資源不足」把報表淹掉",
      "if": [
        [
          "view.essence",
          ">=",
          20
        ]
      ]
    },
    {
      "id": "auto-equip-on",
      "once": true,
      "cmd": "factory.setAutoEquip",
      "args": {
        "on": true
      },
      "why": "品質高優先穿：開啟自動換裝"
    },
    {
      "id": "auto-advance-init-on",
      "everySec": 15,
      "cmd": "stage.setAutoAdvance",
      "args": {
        "on": true
      },
      "why": "持續保持自動推關勾選狀態"
    },
    {
      "id": "buy-inv-upgrade",
      "everySec": 300,
      "if": [
        [
          "panels.inv.cap",
          "<",
          700
        ]
      ],
      "cmd": "player.buyInvUpgrade",
      "why": "背包策略：穩定將背包逐步解鎖至700格"
    },
    {
      "id": "add-furnace-max",
      "everySec": 900,
      "cmd": "newforge.addFurnace",
      "why": "熔爐解鎖到當前可開的最大數量"
    },
    {
      "id": "salvage-best-strategy",
      "once": true,
      "cmd": "newforge.setQuality",
      "argsList": [
        {
          "furnaceId": 1,
          "rarity": 0,
          "on": true
        },
        {
          "furnaceId": 1,
          "rarity": 1,
          "on": true
        }
      ],
      "why": "只拆解普通與優良(R0~R1)，稀有以上保留在背包當換裝候選"
    },
    {
      "id": "learn-potential-talents",
      "everySec": 30,
      "cmd": "talent.potentialUpgrade",
      "expand": [
        {
          "key": "id",
          "list": "skillPriority"
        }
      ],
      "why": "潛力技能解鎖後優先潛力技能升級"
    },
    {
      "id": "learn-skills",
      "everySec": 15,
      "cmd": "skill.learn",
      "expand": [
        {
          "key": "id",
          "listByLevel": [
            {
              "maxLevel": 50,
              "list": "skillEarly"
            },
            {
              "maxLevel": 100,
              "list": "skillMid"
            },
            {
              "list": "skillLate"
            }
          ]
        }
      ],
      "why": "依 player_strategy.md 技能升級優先順序分段：前期(≤50)先點生命上限被動與護盾／持續恢復；中期(51~100)把被動技能全點滿；後期(101+)依裝備詞條方向（targetAffixes 為物理向）集中投物理。清單順序即投點優先序，點數不足時後面的由遊戲擋下"
    },
    {
      "id": "fuse-skills",
      "everySec": 600,
      "cmd": "skill.fuse",
      "why": "主動使用技能融合以強化技能"
    },
    {
      "id": "talent-upgrade-step1",
      "everySec": 60,
      "cmd": "talent.upgrade",
      "expand": [
        {
          "key": "id",
          "list": "talentStep1"
        }
      ],
      "why": "天賦策略：優先將1轉天賦全點滿"
    },
    {
      "id": "talent-upgrade-step2",
      "everySec": 60,
      "cmd": "talent.upgrade",
      "expand": [
        {
          "key": "id",
          "list": "talentStep2"
        }
      ],
      "why": "天賦策略：再將2轉天賦全點滿"
    },
    {
      "id": "gem-shop-buy-1",
      "everySec": 1200,
      "cmd": "gem.shopBuyAll",
      "why": "每20分鐘買光所有商店寶石"
    },
    {
      "id": "gem-shop-refresh-5x",
      "everySec": 1200,
      "cmd": "gem.shopRefresh",
      "why": "重置寶石商店5次後再買光"
    },
    {
      "id": "gem-shop-buy-2",
      "everySec": 1200,
      "cmd": "gem.shopBuyAll",
      "why": "重置後再次買光"
    },
    {
      "id": "tower-auto",
      "everySec": 1200,
      "cmd": "tower.startAuto",
      "args": {
        "floor": {
          "$add": [
            {
              "$path": "panels.tower.tower.highest"
            },
            1
          ]
        },
        "count": 1
      },
      "why": "每20分鐘嘗試一次BOSS高塔挑戰"
    },
    {
      "id": "tower-finish-if-needed",
      "everySec": 30,
      "if": [
        [
          "panels.tower.tower.active",
          "truthy"
        ]
      ],
      "cmd": "tower.finish",
      "why": "高塔挑戰結束後回到一般場景戰鬥繼續遊玩"
    }
  ]
}
