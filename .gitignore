# --- 依賴套件 (Dependencies) ---
# 絕對不要上傳這幾千個檔案
node_modules/
jspm_packages/
.npm/

# --- 暫存與自動化測試 (Temp & Automation) ---
# 根據你的規範，自動化測試產生的截圖與日誌應排除
tmp/*
# 但保留 tmp 資料夾本身（選用，若需要保留目錄結構可加這一行）
!tmp/.gitkeep

# --- 環境變數與秘密資訊 (Environment / Secrets) ---
.env
.env.local
.env.development.local

# --- 作業系統產生的雜物 (OS Junk) ---
.DS_Store
Thumbs.db
desktop.ini

# --- 編輯器私有設定 (Editor Private Config) ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- 日誌檔案 (Logs) ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# 測試與自動化產出
/tmp/
/screenshots/
*.log
.logs/
playwright-report/
test-results/

# 參數套用的重載權杖（每次套用都會變，不需版控）
params_version.txt

# Excel 開啟中的暫存鎖定檔（~$ 開頭），不需版控
~$*.xlsx
config/Excel/~$*.xlsx

# 模擬器動態產出之日誌與存檔
ai_player_action_log.txt
save_ai_player_500h.json
save_initial.json

# AI 玩家模擬輸出（存檔／快照／原生事件日誌），每次跑都會重生成
sim_out*/
sim_batch*/

# 真人 vs AI 曲線對照的輸出（scripts/compare_runs.js）
compare_runs.json

# 真人操作錄製檔（js/recorder.js 匯出，可能有數十 MB）
scratch/recordings/

# 模擬儀表板伺服器的輸出（啟動數值模擬器.bat 產生，失敗時用來顯示原因）
sim_server.log

# 模擬伺服器實際使用的連接埠（啟動時挑，每次可能不同）
sim_server.port
