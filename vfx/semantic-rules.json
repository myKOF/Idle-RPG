   },
   "evidence": [
    "light-masks-1.0/default/cone_composed_a.png",
    "light-masks-1.0/default/cone_composed_c_noise.png"
   ],
   "propagation": "family",
   "semantics": {
    "kind": "vfx",
    "shape": "cone",
    "usage": [
     "beam",
     "mask",
     "core"
    ],
    "element": "neutral",
    "tags": [
     "directional",
     "soft"
