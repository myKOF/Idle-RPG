{
  "schemaVersion": 1,
  "kind": "vfx-semantic-rules",
  "note": "AI 標註輸入。每條規則都必須列出實際看過的代表圖（evidence）。propagation 決定語意能傳播多遠：evidenceOnly=只給看過的；group=再加上像素簽章證實同形的載體變體；family=同家族其他成員（信心降為 medium）。",
  "libraryId": "effects-materials",
  "rules": [
    {
      "ruleId": "particle/fire",
      "select": {
        "package": "kenney_particle-pack",
        "namePattern": "^fire_\\d+$",
        "format": "png"
      },
      "evidence": [
        "kenney_particle-pack/png-transparent/fire_01.png"
      ],
      "propagation": "family",
      "semantics": {
        "kind": "vfx",
        "shape": "cloud",
        "usage": [
          "core",
          "smoke"
        ],
        "element": "neutral",
        "tags": [
          "noisy",
          "dense"
        ]
      },
      "observation": "灰階湍流雲團，非彩色火焰；可染成任何元素色"
    },
    {
      "ruleId": "particle/flame",
      "select": {
