    "light-masks-1.0/default/circle_rings_a.png"
   ],
   "propagation": "family",
   "semantics": {
    "kind": "vfx",
    "shape": "ring",
    "usage": [
     "ring",
     "glow",
     "impact"
    ],
    "element": "neutral",
    "tags": [
     "radial",
     "layered",
     "symmetric"
    ]
   },
   "observation": "同心多環＋亮心"
  },
  {
   "ruleId": "lightmask/cone_composed",
